      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="EXEC DropConstraints 'tblParty,tblPartyName,tblPartyEmail,tblPartyAddress,tblPartyEmployment,tblPartyImage,tblPartyMarriage,&#xA;tblPartyNotification,tblPartyPassword,tblPartyPasswordHistory,tblPartyPhone,tblPartyPrescription,tblPartyRecusal,tblPartyRelationship,tblPartyTest,tblPartyEMail'&#xA;&#xA;TRUNCATE TABLE tblParty&#xA;TRUNCATE TABLE tblPartyName&#xA;TRUNCATE TABLE tblPartyEmail&#xA;TRUNCATE TABLE tblPartyAddress&#xA;TRUNCATE TABLE tblPartyEmployment&#xA;TRUNCATE TABLE tblPartyImage&#xA;TRUNCATE TABLE tblPartyMarriage&#xA;TRUNCATE TABLE tblPartyNotification&#xA;TRUNCATE TABLE tblPartyPassword&#xA;TRUNCATE TABLE tblPartyPasswordHistory&#xA;TRUNCATE TABLE tblPartyPhone&#xA;TRUNCATE TABLE tblPartyPrescription&#xA;TRUNCATE TABLE tblPartyRecusal&#xA;TRUNCATE TABLE tblPartyRelationship&#xA;TRUNCATE TABLE tblPartyTest&#xA;TRUNCATE TABLE tblPartyEMail&#xA;&#xA;EXEC READD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\VICTIMS_AND_WITNESSES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4ca29c1e-3f3f-42e4-9819-dcd446ec1d4f}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="VICTIMS_AND_WITNESSES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--VICTIMS&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,V.DOB AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,ISNULL(LTRIM(RTRIM(V.Comments)),'') AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(V.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(V.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(V.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'VIC' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Victims V WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--103&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(V.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(V.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,ISNULL(LTRIM(RTRIM(V.Title)),'') AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(V.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Victims V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(V.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Last_Name)),'') + ISNULL(LTRIM(RTRIM(V.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--103&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(V.Street)),'') AS Address1&#xA;        ,ISNULL(LTRIM(RTRIM(V.Street2)),'') AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(V.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(V.State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(V.Zip)),'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Victims V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(V.Street)),'')&#xA;                                                         AND PA.Address2 = ISNULL(LTRIM(RTRIM(V.Street2)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(V.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(V.State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(V.Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.Street2)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.State)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--9  (94 VICTIMS HAD BLANK ADDRESSES)&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; '' AND ISNUMERIC(V.Phone) = 1 AND LEN(V.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(V.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(V.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(V.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(V.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Victims V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; '' AND ISNUMERIC(V.Phone) = 1 AND LEN(V.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(V.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(V.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(V.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(V.Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; ''&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--6  (97 VICTIMS HAD BLANK ADDRESSES)&#xA;&#xA;&#xA;--VICTIMS OF VIOLATOR&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,V.DOB AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,ISNULL(LTRIM(RTRIM(V.Comments)),'') AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(V.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(V.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(V.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'VOV' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Victims_Of_Violator V WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--452&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(V.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(V.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,ISNULL(LTRIM(RTRIM(V.Title)),'') AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(V.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Victims_Of_Violator V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(V.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Last_Name)),'') + ISNULL(LTRIM(RTRIM(V.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--452&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(V.Street)),'') AS Address1&#xA;        ,'' AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(V.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(V.State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(V.Zip)),'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Victims_Of_Violator V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(V.Street)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(V.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(V.State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(V.Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.State)),'')&#xA;         + ISNULL(LTRIM(RTRIM(V.Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--281  (171 VICTIMS OF VIOLATORS HAD BLANK ADDRESSES)&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; '' AND ISNUMERIC(V.Phone) = 1 AND LEN(V.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(V.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(V.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(V.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(V.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Victims_Of_Violator V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'VOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; '' AND ISNUMERIC(V.Phone) = 1 AND LEN(V.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(V.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(V.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(V.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(V.Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Phone)),'') &gt; ''&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--149  (303 VICTIMS OF VIOLATORS HAD BLANK PHONE NUMBERS)&#xA;&#xA;&#xA;--WITNESSES&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(W.Name)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'WIT' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),W.Witness_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Witness W WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'WIT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),W.Witness_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--1  (CIVIL)&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(W.Name)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(W.Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Witness W WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'WIT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),W.Witness_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(W.Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(W.Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(W.Address_1)),'') AS Address1&#xA;        ,ISNULL(LTRIM(RTRIM(W.Address_2)),'') AS Address2&#xA;        ,'' AS City&#xA;        ,'' AS State&#xA;        ,'' AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Witness W WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'WIT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),W.Witness_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(W.Address_1)),'')&#xA;                                                         AND PA.Address2 = ISNULL(LTRIM(RTRIM(W.Address_2)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(W.Address_1)),'')&#xA;         + ISNULL(LTRIM(RTRIM(W.Address_2)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\XREF_tblParty_UserID"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7053b32c-4532-4a34-972c-751fdd17daf9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="XREF_tblParty_UserID"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;TRUNCATE TABLE XREF_tblParty_UserID&#xA;&#xA;UPDATE p SET p.FamilyCode=''&#xA;FROM&#xA;&#x9;tblParty p WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;(&#xA;&#x9;SELECT FamilyCode,MIN(PartyID) MinPartyID&#xA;&#x9;FROM  &#xA;&#x9;&#x9;tblParty WITH(NOLOCK)&#xA;&#x9;WHERE&#xA;&#x9;&#x9;PrimaryPartyType IN ('CLK','JDG')&#xA;&#x9;&#x9;AND FamilyCode &gt; ''&#xA;&#x9;GROUP BY&#xA;&#x9;&#x9;FamilyCode&#xA;&#x9;HAVING COUNT(*)&gt;=2&#xA;&#x9;) x&#xA;&#x9;&#x9;ON p.FamilyCode=x.FamilyCode&#xA;WHERE&#xA;&#x9;p.PartyID&lt;&gt;x.MinPartyID&#xA;&#xA;&#xA;INSERT INTO XREF_tblParty_UserID&#xA;(&#xA;&#x9; UserID&#xA;&#x9;,PartyID&#xA;)&#xA;SELECT P.FamilyCode AS UserID&#xA;      ,P.PartyID AS PartyID&#xA;  FROM tblParty P WITH (NOLOCK)&#xA; WHERE P.PrimaryPartyType IN ('CLK','JDG')&#xA;   AND ISNULL(P.FamilyCode,'') &gt; ''&#xA;--138 (132 CLK USERS + 6 JDG USERS)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
