      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;TRUNCATE TABLE TMPPARTY&#xA;TRUNCATE TABLE TMPPARTYNAME&#xA;TRUNCATE TABLE TMPPARTYADDRESS&#xA;TRUNCATE TABLE TMPPARTYPHONE&#xA;TRUNCATE TABLE TMPPARTYEMAIL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
