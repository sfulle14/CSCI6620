    <DTS:Executable
      DTS:refId="Package\INSERT PRESERVE PARTIES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2c287cb1-d86b-442b-9293-c48b97aa180c}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT PRESERVE PARTIES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO TMPPARTY&#xA;(&#xA;  PartyCode&#xA; ,PrimaryPartyType&#xA; ,PrimaryPartySubType&#xA; ,Employer&#xA; ,AgencyID&#xA; ,DivisionID&#xA; ,DepartmentID&#xA; ,Active&#xA; ,DOB&#xA; ,DOD&#xA; ,Gender&#xA; ,HairColor&#xA; ,EyeColor&#xA; ,SSN&#xA; ,Classification&#xA; ,DriversLicenseNumber&#xA; ,DriversLicenseState&#xA; ,DriversLicenseClass&#xA; ,DriversLicenseExpirationYear&#xA; ,DLOverride&#xA; ,Height&#xA; ,Weight&#xA; ,IdentifyingCharacteristics&#xA; ,Race&#xA; ,CountryOfBirth&#xA; ,CountryOfCitizenship&#xA; ,USCitizen&#xA; ,NeedsInterpreterLanguage&#xA; ,StateIDNumber&#xA; ,DOCNumber&#xA; ,FBINumber&#xA; ,BarNumber&#xA; ,ORINumber&#xA; ,BadgeNumber&#xA; ,Comments&#xA; ,EMailAddress&#xA; ,ContactName&#xA; ,SignatureFile&#xA; ,DefaultParentPartyID&#xA; ,MergedToPartyID&#xA; ,UserLogin&#xA; ,UserActive&#xA; ,UserRoleID&#xA; ,UserPassword&#xA; ,UserLoginCount&#xA; ,UserGUID&#xA; ,UserLastLogin&#xA; ,UserDefaultCheckoutLocation&#xA; ,UserAutoLoginCode&#xA; ,PIACallDate&#xA; ,ShowInBatchScan&#xA; ,CountyBranchID&#xA; ,EscrowAccountID&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,ICPConnection&#xA; ,ICPEmail&#xA; ,InmateID&#xA; ,Name&#xA; ,PasswordLastModified&#xA; ,PasswordMinimumLength&#xA; ,PasswordMaximumLength&#xA; ,PasswordDigitRequired&#xA; ,PasswordLetterRequired&#xA; ,PasswordSpecialCharacterRequired&#xA; ,PasswordDuplicateControlCount&#xA; ,PasswordExpiredDays&#xA; ,eCitationAgencyMap&#xA; ,JailAgencyMap&#xA; ,PartyAlertCode&#xA; ,BondInsurancePartyID&#xA; ,FamilyCode&#xA; ,DNAObtainedDate&#xA; ,OriginalORASDate&#xA; ,RiskAssessmentLevel&#xA; ,CityOfBirth&#xA; ,StateOfBirth&#xA; ,FederalTaxID&#xA; ,WebValidation&#xA; ,WebValidationExpiration&#xA; ,OldPartyID&#xA; ,Ethnicity&#xA;)&#xA;SELECT&#xA;  PartyCode&#xA; ,PrimaryPartyType&#xA; ,PrimaryPartySubType&#xA; ,Employer&#xA; ,AgencyID&#xA; ,DivisionID&#xA; ,DepartmentID&#xA; ,Active&#xA; ,DOB&#xA; ,DOD&#xA; ,Gender&#xA; ,HairColor&#xA; ,EyeColor&#xA; ,SSN&#xA; ,Classification&#xA; ,DriversLicenseNumber&#xA; ,DriversLicenseState&#xA; ,DriversLicenseClass&#xA; ,DriversLicenseExpirationYear&#xA; ,DLOverride&#xA; ,Height&#xA; ,Weight&#xA; ,IdentifyingCharacteristics&#xA; ,Race&#xA; ,CountryOfBirth&#xA; ,CountryOfCitizenship&#xA; ,USCitizen&#xA; ,NeedsInterpreterLanguage&#xA; ,StateIDNumber&#xA; ,DOCNumber&#xA; ,FBINumber&#xA; ,BarNumber&#xA; ,ORINumber&#xA; ,BadgeNumber&#xA; ,Comments&#xA; ,EMailAddress&#xA; ,ContactName&#xA; ,SignatureFile&#xA; ,DefaultParentPartyID&#xA; ,MergedToPartyID&#xA; ,UserLogin&#xA; ,UserActive&#xA; ,UserRoleID&#xA; ,UserPassword&#xA; ,UserLoginCount&#xA; ,UserGUID&#xA; ,UserLastLogin&#xA; ,UserDefaultCheckoutLocation&#xA; ,UserAutoLoginCode&#xA; ,PIACallDate&#xA; ,ShowInBatchScan&#xA; ,CountyBranchID&#xA; ,EscrowAccountID&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,ICPConnection&#xA; ,ICPEmail&#xA; ,InmateID&#xA; ,Name&#xA; ,PasswordLastModified&#xA; ,PasswordMinimumLength&#xA; ,PasswordMaximumLength&#xA; ,PasswordDigitRequired&#xA; ,PasswordLetterRequired&#xA; ,PasswordSpecialCharacterRequired&#xA; ,PasswordDuplicateControlCount&#xA; ,PasswordExpiredDays&#xA; ,eCitationAgencyMap&#xA; ,JailAgencyMap&#xA; ,PartyAlertCode&#xA; ,BondInsurancePartyID&#xA; ,FamilyCode&#xA; ,DNAObtainedDate&#xA; ,OriginalORASDate&#xA; ,RiskAssessmentLevel&#xA; ,CityOfBirth&#xA; ,StateOfBirth&#xA; ,FederalTaxID&#xA; ,WebValidation&#xA; ,WebValidationExpiration&#xA; ,PartyID&#xA; ,Ethnicity&#xA;FROM tblParty  WITH(NOLOCK)&#xA;WHERE &#xA;  ISNULL(PRIMARYPARTYTYPE,'') IN ('SYS','CLK','JDG','ATT','AGCY','BD','PBO','OFF')&#xA; OR &#xA;  ISNULL(USERLOGIN,'') &lt;&gt; '' &#xA;ORDER BY &#xA;    PARTYID&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\JUDGES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{141fcf5d-d647-4571-811c-72f3e3141b23}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="JUDGES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @JDGGROUPID INT = (SELECT G.Group_Id FROM BMLakewood_Source.dbo.Groups G WITH (NOLOCK) WHERE LTRIM(RTRIM(G.Group_Name)) = 'Judges')&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(SUBSTRING(LTRIM(RTRIM(J.Last_Name)),1,3),'') AS PartyCode&#xA;        ,'JDG' AS PrimaryPartyType&#xA;        ,CASE WHEN J.Visiting_Judge = 1 THEN 'VJ' ELSE '' END AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,CASE WHEN J.Retired = 1 THEN 0 ELSE 1 END AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(U.BCI_Employee_Id)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,ISNULL(LTRIM(RTRIM(J.Note)),'') AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.User_Name)),'') AS UserLogin&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(U.User_Name)),'') &gt; '' THEN 1 ELSE 0 END AS UserActive&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(U.User_Name)),'') &gt; '' THEN 1 ELSE 0 END AS UserRoleID&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(U.User_Name)) + '123',''),50) AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(J.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(J.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(J.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,ISNULL(CONVERT(VARCHAR(50),U.User_Id),'') AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),J.Judge_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Judges J WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Users U WITH (NOLOCK) ON U.Group_Id = @JDGGROUPID AND (LEN(LTRIM(RTRIM(J.Last_Name))) &gt; 1 AND LEN(LTRIM(RTRIM(J.First_Name))) &gt; 1)&#xA;&#x9;&#x9;                                                                                         AND (UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.Last_Name)) + '%'&#xA;                                                                                                  OR UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.First_Name)) + '%')&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),J.Judge_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--16&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(J.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(J.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(J.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(J.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Judges J WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),J.Judge_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(J.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(J.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(J.Last_Name)),'') + ISNULL(LTRIM(RTRIM(J.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--16&#xA;&#xA;&#xA;--ADDITIONAL JUDGES NAMES FROM USERS TABLE&#xA;&#xA;--DECLARE @JDGGROUPID INT = (SELECT G.Group_Id FROM BMLakewood_Source.dbo.Groups G WITH (NOLOCK) WHERE LTRIM(RTRIM(G.Group_Name)) = 'Judges')&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(U.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(U.User_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,1 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Judges J WITH (NOLOCK)&#xA;         INNER JOIN BMLakewood_Source.dbo.Users U WITH (NOLOCK) ON U.Group_Id = @JDGGROUPID AND (LEN(LTRIM(RTRIM(J.Last_Name))) &gt; 1 AND LEN(LTRIM(RTRIM(J.First_Name))) &gt; 1)&#xA;&#x9;&#x9;                                                                                    AND (UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.Last_Name)) + '%'&#xA;                                                                                             OR UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.First_Name)) + '%')&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 1 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(U.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Last_Name)),'') + ISNULL(LTRIM(RTRIM(U.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--4  (USERS IN JUDGES USER GROUP AND ALSO IN JUDGES TABLE)&#xA;&#xA;&#xA;--DECLARE @JDGGROUPID INT = (SELECT G.Group_Id FROM BMLakewood_Source.dbo.Groups G WITH (NOLOCK) WHERE LTRIM(RTRIM(G.Group_Name)) = 'Judges')&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Note)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,1 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Note)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Judges J WITH (NOLOCK)&#xA;         INNER JOIN BMLakewood_Source.dbo.Users U WITH (NOLOCK) ON U.Group_Id = @JDGGROUPID AND (LEN(LTRIM(RTRIM(J.Last_Name))) &gt; 1 AND LEN(LTRIM(RTRIM(J.First_Name))) &gt; 1)&#xA;&#x9;&#x9;                                                                                    AND (UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.Last_Name)) + '%'&#xA;                                                                                             OR UPPER(LTRIM(RTRIM(U.Note))) LIKE '%' + LTRIM(RTRIM(J.First_Name)) + '%')&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 1 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Note)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Note)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--4  (USERS IN JUDGES USER GROUP AND ALSO IN JUDGES TABLE)&#xA;&#xA;&#xA;--2 USERS IN JUDGES USER GROUP BUT NOT IN JUDGES TABLE&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         SUBSTRING(LTRIM(RTRIM(U.User_Name)),1,3) AS PartyCode&#xA;        ,'JDG' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(U.BCI_Employee_Id)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,LTRIM(RTRIM(U.User_Name)) AS UserLogin&#xA;        ,1 AS UserActive&#xA;        ,1 AS UserRoleID&#xA;        ,LEFT(LTRIM(RTRIM(U.User_Name)) + '123',50) AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(U.Note)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,ISNULL(CONVERT(VARCHAR(50),U.User_Id),'') AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),U.User_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Groups G WITH (NOLOCK) ON G.Group_Id = U.Group_Id&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.User_Name)),'') &gt; ''&#xA;     AND LTRIM(RTRIM(G.Group_Name)) = 'Judges'&#xA;     AND P.PartyID IS NULL&#xA;--2  (USERS IN JUDGES USER GROUP BUT NOT IN JUDGES TABLE)&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(U.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(U.User_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType IN (1,0) AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(U.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Last_Name)),'') + ISNULL(LTRIM(RTRIM(U.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--2  (USERS IN JUDGES USER GROUP BUT NOT IN JUDGES TABLE)&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Note)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,1 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Note)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'JDG' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 1 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Note)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Note)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--2  (USERS IN JUDGES USER GROUP BUT NOT IN JUDGES TABLE)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\OFFICERS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4eef77fa-2683-4e48-a70c-281b59bbe241}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="OFFICERS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(LTRIM(RTRIM(O.Officer_Badge)),'') AS PartyCode&#xA;        ,'OFF' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,ISNULL(PAG.PartyID,0) AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,ISNULL(O.Active,1) AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,ISNULL(LTRIM(RTRIM(O.Officer_Badge)),'') AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(O.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(O.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(O.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),O.Officer_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Officers O WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty PAG WITH (NOLOCK) ON PAG.PrimaryPartyType = 'AGCY' AND PAG.WebValidation = ISNULL(CONVERT(VARCHAR(255),O.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'OFF' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),O.Officer_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--587&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(O.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(O.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(O.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(O.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Officers O WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'OFF' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),O.Officer_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(O.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(O.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(O.Last_Name)),'') + ISNULL(LTRIM(RTRIM(O.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--587&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PRESERVE ADDRESSES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{160594c1-6711-43fe-bddf-b287b6cb77b2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PRESERVE ADDRESSES"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;SET IDENTITY_INSERT TMPPARTYADDRESS ON&#xA;&#xA;INSERT INTO TMPPARTYADDRESS&#xA;(&#xA;  PartyAddressID&#xA; ,PartyID&#xA; ,AddressType&#xA; ,Address1&#xA; ,Address2&#xA; ,City&#xA; ,[State]&#xA; ,Zip&#xA; ,Country&#xA; ,Active&#xA; ,Confidential&#xA; ,CreatedWithinCaseID&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA;)&#xA;SELECT &#xA;  PA.PartyAddressID&#xA; ,P.PARTYID&#xA; ,CASE ISNULL(PA.AddressType,'') WHEN '' THEN 'DEFAULT' ELSE PA.ADDRESSTYPE END&#xA; ,PA.Address1&#xA; ,PA.Address2&#xA; ,PA.City&#xA; ,PA.[State]&#xA; ,PA.Zip&#xA; ,PA.Country&#xA; ,PA.Active&#xA; ,PA.Confidential&#xA; ,PA.CreatedWithinCaseID&#xA; ,PA.CreateByUserID&#xA; ,PA.CreateDate&#xA; ,PA.ModifyByUserID&#xA; ,PA.ModifyDate&#xA;FROM TBLPARTYADDRESS PA WITH (NOLOCK)&#xA; INNER JOIN TMPPARTY P WITH (NOLOCK)&#xA;  ON PA.PARTYID=P.OldPartyID&#xA;ORDER BY &#xA; P.PARTYID&#xA;&#xA;&#xA;SET IDENTITY_INSERT TMPPARTYADDRESS OFF" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PRESERVE EMAILS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{93e87ab2-8f1d-4ef5-9f50-88c9fe99599e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PRESERVE EMAILS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO TMPPARTYEMAIL&#xA; ([PartyID]&#xA; ,[EMailType]&#xA; ,[EMailAddress]&#xA; ,[Active]&#xA; ,[CreatedWithinCaseID]&#xA; ,[CreateByUserID]&#xA; ,[CreateDate]&#xA; ,[ModifyByUserID]&#xA; ,[ModifyDate])&#xA; SELECT &#xA;   P.PARTYID&#xA;  ,PP.EMAILTYPE&#xA;  ,PP.EMAILADDRESS&#xA;  ,PP.ACTIVE&#xA;  ,PP.CREATEDWITHINCASEID&#xA;  ,PP.CREATEBYUSERID&#xA;  ,PP.CREATEDATE&#xA;  ,PP.MODIFYBYUSERID&#xA;  ,PP.MODIFYDATE&#xA; FROM TBLPARTYEMAIL PP WITH (NOLOCK)&#xA;   INNER JOIN TMPPARTY P WITH (NOLOCK)&#xA;    ON PP.PARTYID=P.OldPartyId&#xA;ORDER BY &#xA; P.PARTYID&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PRESERVE NAMES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{09142773-b825-44f9-a990-797faf198d47}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PRESERVE NAMES"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="INSERT INTO TMPPARTYNAME&#xA;    ([PartyID]&#xA;    ,[LastOrBusinessName]&#xA;    ,[FirstName]&#xA;    ,[MiddleName]&#xA;    ,[PrefixName]&#xA;    ,[SuffixName]&#xA;    ,[PartyNameType]&#xA;    ,[SoundexCode]&#xA;    ,[CreateByUserID]&#xA;    ,[CreateDate]&#xA;    ,[ModifyByUserID]&#xA;    ,[ModifyDate])&#xA; SELECT &#xA; P.PARTYID&#xA; ,PN.LastOrBusinessName&#xA; ,PN.FirstName&#xA; ,PN.MiddleName&#xA; ,PN.PrefixName&#xA; ,PN.SuffixName&#xA; ,PN.PartyNameType&#xA; ,PN.SoundexCode&#xA; ,PN.CreateByUserID&#xA; ,PN.CreateDate&#xA; ,PN.ModifyByUserID&#xA; ,PN.ModifyDate&#xA;FROM TBLPARTYNAME PN WITH (NOLOCK)&#xA;   INNER JOIN TMPPARTY P WITH (NOLOCK)&#xA;  ON PN.PARTYID = P.OldPartyID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PROBATION_OFFICERS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{d5cf0843-b421-44dd-94fc-81ab1c2f39f2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PROBATION_OFFICERS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'PBO' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(PO.Officer_Name)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),PO.Probation_Officer_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Probation_Officers PO WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'PBO' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PO.Probation_Officer_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--3&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(PO.Officer_Name)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(PO.Officer_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Probation_Officers PO WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'PBO' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PO.Probation_Officer_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(PO.Officer_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PO.Officer_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--3&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PRSERVE PHONES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7048adb6-9c5e-4273-85de-9d2c675740d8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PRSERVE PHONES"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO TMPPARTYPHONE&#xA; ([PartyID]&#xA; ,[PhoneNumber]&#xA; ,[PhoneType]&#xA; ,[CreateByUserID]&#xA; ,[CreateDate]&#xA; ,[ModifyByUserID]&#xA; ,[ModifyDate])&#xA; SELECT &#xA;   P.PARTYID&#xA;  ,PP.PHONENUMBER&#xA;  ,PP.PHONETYPE&#xA;  ,PP.CREATEBYUSERID&#xA;  ,PP.CREATEDATE&#xA;  ,PP.MODIFYBYUSERID&#xA;  ,PP.MODIFYDATE&#xA; FROM TBLPARTYPHONE PP WITH (NOLOCK)&#xA;   INNER JOIN TMPPARTY P WITH (NOLOCK)&#xA;    ON PP.PARTYID=P.OldPartyId&#xA;ORDER BY &#xA; P.PARTYID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PUBLIC_INFO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{c001e0e2-27c0-4769-ba43-ff07bd3e8866}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PUBLIC_INFO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;;WITH PublicDetails_cte AS&#xA;      (SELECT CONVERT(VARCHAR(50),PD.SSN) SSN&#xA;             ,MAX(LTRIM(RTRIM(PD.OL_Number))) OL_Number&#xA;             ,MAX(LTRIM(RTRIM(L.Code))) RaceLookupCode&#xA;             ,MAX(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.Sex)))) Sex&#xA;             ,MAX(LTRIM(RTRIM(PD.Height))) Height&#xA;             ,MAX(LTRIM(RTRIM(PD.Weight))) Weight&#xA;             ,MAX(LTRIM(RTRIM(PD.Hair))) Hair&#xA;             ,MAX(LTRIM(RTRIM(PD.Eyes))) Eyes&#xA;             ,MAX(LTRIM(RTRIM(PD.Note))) Note&#xA;             ,MAX(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.OL_State)))) OL_State&#xA;             ,MAX(CONVERT(VARCHAR(50),PD.Public_Detail_Id)) Public_Detail_Id&#xA;         FROM BMLakewood_Source.dbo.Public_Details PD WITH (NOLOCK)&#xA;              LEFT OUTER JOIN tblLookup L WITH (NOLOCK) ON L.LookupGroup = 'Race' AND L.LookupKey = CONVERT(VARCHAR(50),PD.Race_Id)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))),'') &gt; ''&#xA;         AND LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))) != '000000000'&#xA;        GROUP BY CONVERT(VARCHAR(50),PD.SSN))&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.Employment)),'') AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,PUI.Birth_Date AS DOB&#xA;        ,NULL AS DOD&#xA;        ,CASE WHEN ISNULL(PDC.Sex,'') = 'N' THEN 'U' ELSE ISNULL(PDC.Sex,'') END AS Gender&#xA;        ,CASE WHEN ISNULL(PDC.Hair,'') = 'BRO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRW' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BR' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROW' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BOWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRWON' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BORWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BALD/BROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROWN/BALD' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRON' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BR0' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROW N' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BR\OWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BORNW' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRONW' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BVROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLOWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BNR' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BOR' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'VRO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'bBROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROAN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROWN H' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BBRO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRO HAZ' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRPWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BROWN`' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRI' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'HBLK' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLN' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLONDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLO' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLOND' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLND' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLON' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLONE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLODNE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BONDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BND' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLL' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GLN' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRONDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RED.BLONDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLONDW' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLINDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BOLNDE' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLNQ' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BBLN' THEN 'BLN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLACK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLAKC' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLA' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLM' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BKL' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLCK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLACL' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'B;ACK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLACKE' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BBLK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLACIK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLAACK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLK BRO' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLACK/BALD' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BKACK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLAVK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLQCK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLU' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLUE' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLD' THEN 'BLD'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BALD' THEN 'BLD'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BAL' THEN 'BLD'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BALS' THEN 'BLD'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BLDE' THEN 'BLD'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GRN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GREEN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GRY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GRAY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GREY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GRA' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GR' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GRO' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'S&amp;P' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SLV' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SIL' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRAY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RAY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BREY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'BRO/GRY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'GR4AY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WHI' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WHT' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WHITE' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WHIT' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WH' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'WT' THEN 'WHI'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RED' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RD' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RDE' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RE' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'AUB' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'AUBURN' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'RED/BRO' THEN 'RED'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'PINK' THEN 'PNK'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SDY' THEN 'SDY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SANDY' THEN 'SDY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SAND' THEN 'SDY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SNDY' THEN 'SDY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'SND' THEN 'SDY'&#xA;              WHEN ISNULL(PDC.Hair,'') = 'MIXED' THEN 'UNK'&#xA;              ELSE 'XXX'&#xA;          END AS HairColor&#xA;        ,CASE WHEN ISNULL(PDC.Eyes,'') = 'BRO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRWON' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BR' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BEO' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRW' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'ROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'VROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BBROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BNROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BOWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRON' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BR0' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRL' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRU' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BRUE' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BR N' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'B ROWN' THEN 'BRO'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLU' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLUE' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLUEC' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLUED' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLLUE' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLY' THEN 'BLU'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZ' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZEL' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZL' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HZL' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HA' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HZ' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZZLE' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZELLE' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HL' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'H' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAAEL' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAZLE' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'HAR' THEN 'HAZ'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GRN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GREEN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GR' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GRE' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GR4EEN' THEN 'GRN'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLACK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BK' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'BLKL' THEN 'BLK'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GRY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GRAY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GREY' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'GRA' THEN 'GRY'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'DIA' THEN 'MUL'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'DIC' THEN 'MUL'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'DC' THEN 'MUL'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'D/C' THEN 'MUL'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'DICHROM' THEN 'MUL'&#xA;              WHEN ISNULL(PDC.Eyes,'') = 'DICHROMATI' THEN 'MUL'&#xA;              ELSE 'XXX'&#xA;          END AS EyeColor&#xA;        ,CASE WHEN ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') &gt; '' AND ISNUMERIC(ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'')) = 1 AND LEN(ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'')) = 9&#xA;              THEN dbo.fnFormatSSN(ISNULL(CONVERT(VARCHAR(50),PUI.SSN),''))&#xA;              ELSE ''&#xA;          END AS SSN&#xA;        ,'' AS Classification&#xA;        ,ISNULL(PDC.OL_Number,'') AS DriversLicenseNumber&#xA;        ,ISNULL(PDC.OL_State,'') AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,ISNULL(PDC.Height,'') AS Height&#xA;        ,ISNULL(PDC.Weight,'') AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,ISNULL(PDC.RaceLookupCode,'') AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,ISNULL(PDC.Note,'') AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(PUI.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(PUI.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(PUI.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'PUBLIC' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.Place_of_Birth)),'') AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;         LEFT OUTER JOIN PublicDetails_cte PDC WITH (NOLOCK) ON PDC.SSN = CONVERT(VARCHAR(50),PUI.SSN)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Public_Detail_Probation PDP WITH (NOLOCK) ON PDP.SSN = PUI.SSN&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PUI.SSN),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--498,583  (1:30)&#xA;&#xA;&#xA;--PUBLIC INFO NAMES&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.Title)),'') AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(PUI.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PUI.SSN),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID&#xA;                                                      AND PN.PartyNameType = 0&#xA;                                                      AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(PUI.Last_Name)),'')&#xA;                                                      AND PN.FirstName = ISNULL(LTRIM(RTRIM(PUI.First_Name)),'')&#xA;                                                      AND PN.MiddleName = ISNULL(LTRIM(RTRIM(PUI.Middle_Initial)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PUI.Last_Name)),'') + ISNULL(LTRIM(RTRIM(PUI.First_Name)),'') &gt; ''&#xA;   AND PN.PartyNameID IS NULL&#xA;--498,570  (13 HAVE BLANK NAMES)&#xA;&#xA;&#xA;--PUBLIC INFO DBA NAMES&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.DBA)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,4 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(PUI.DBA)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PUI.SSN),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID&#xA;                                                      AND PN.PartyNameType = 4&#xA;                                                      AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(PUI.DBA)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PUI.DBA)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--2,807&#xA;&#xA;&#xA;--PUBLIC DETAILS ALIAS NAMES&#xA;&#xA;;WITH PublicDetails_cte AS&#xA;      (SELECT CONVERT(VARCHAR(50),PD.SSN) SSN&#xA;             ,MAX(LTRIM(RTRIM(PD.Alias))) Alias&#xA;         FROM BMLakewood_Source.dbo.Public_Details PD WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))),'') &gt; ''&#xA;          AND ISNULL(LTRIM(RTRIM(PD.Alias)),'') &gt; ''&#xA;         AND LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))) != '000000000'&#xA;        GROUP BY CONVERT(VARCHAR(50),PD.SSN))&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,PDC.Alias AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,1 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(PDC.Alias)) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM PublicDetails_cte PDC WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = PDC.SSN&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID&#xA;                                                      AND PN.PartyNameType = 1&#xA;                                                      AND PN.LastOrBusinessName = PDC.Alias&#xA;   WHERE PN.PartyNameID IS NULL&#xA;--43&#xA;&#xA;&#xA;--PUBLIC INFO ADDRESSES&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.Street)),'') AS Address1&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PUI.Street2)),'') &lt;&gt; ISNULL(LTRIM(RTRIM(PUI.Street)),'') THEN ISNULL(LTRIM(RTRIM(PUI.Street2)),'') ELSE '' END AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PUI.State))),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(PUI.Zip)),'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PUI.SSN),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(PUI.Street)),'')&#xA;                                                         AND PA.Address2 = CASE WHEN ISNULL(LTRIM(RTRIM(PUI.Street2)),'') &lt;&gt; ISNULL(LTRIM(RTRIM(PUI.Street)),'') THEN ISNULL(LTRIM(RTRIM(PUI.Street2)),'') ELSE '' END&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(PUI.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PUI.State))),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(PUI.Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PUI.Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(PUI.Street2)),'')&#xA;         + ISNULL(LTRIM(RTRIM(PUI.City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PUI.State))),'')&#xA;         + ISNULL(LTRIM(RTRIM(PUI.Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;     AND LTRIM(RTRIM(CONVERT(VARCHAR(50),P.SSN))) != '000000000'&#xA;--496,078  (2,505 HAVE BLANK ADDRESSES)&#xA;&#xA;&#xA;--PUBLIC DETAILS ADDRESSES ON OL&#xA;&#xA;INSERT INTO tblLookup&#xA;            (Code&#xA;            ,Description&#xA;            ,LookupGroup&#xA;            ,LookupKey&#xA;            ,UseDescription&#xA;            ,DisplayOrder&#xA;            ,OBTSCode&#xA;            ,TCATSCode&#xA;            ,SRSCode&#xA;            ,Active&#xA;            ,ICPEnabled&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,CCISCode&#xA;            ,CCOCSubType)&#xA;  SELECT -- LookupID&#xA;         'LICENSE' AS Code&#xA;        ,'Address On Ohio License' AS Description&#xA;        ,'AddressType' AS LookupGroup&#xA;        ,'' AS LookupKey&#xA;        ,'' AS UseDescription&#xA;        ,99999 AS DisplayOrder&#xA;        ,'' AS OBTSCode&#xA;        ,'' AS TCATSCode&#xA;        ,'' AS SRSCode&#xA;        ,1 AS Active&#xA;        ,1 AS ICPEnabled&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,'' AS CCISCode&#xA;        ,'' AS CCOCSubType&#xA;   WHERE NOT EXISTS (SELECT 1 FROM tblLookup L WITH (NOLOCK) WHERE L.LookupGroup = 'AddressType' AND L.Code = 'LICENSE')&#xA;--1&#xA;&#xA;&#xA;;WITH PublicDetails_cte AS&#xA;      (SELECT CONVERT(VARCHAR(50),PD.SSN) SSN&#xA;             ,MAX(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.State_On_Ol)))) State_On_Ol&#xA;             ,MAX(LTRIM(RTRIM(PD.Street_On_Ol))) Street_On_Ol&#xA;             ,MAX(LTRIM(RTRIM(PD.City_On_Ol))) City_On_Ol&#xA;             ,MAX(LTRIM(RTRIM(PD.Zip_On_Ol))) Zip_On_Ol&#xA;             ,MAX(LTRIM(RTRIM(PD.Street_On_Ol_2))) Street_On_Ol_2&#xA;         FROM BMLakewood_Source.dbo.Public_Details PD WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))),'') &gt; ''&#xA;         AND LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.SSN))) != '000000000'&#xA;        GROUP BY CONVERT(VARCHAR(50),PD.SSN))&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'LICENSE' AS AddressType&#xA;        ,ISNULL(PDC.Street_On_Ol,'') AS Address1&#xA;        ,CASE WHEN ISNULL(PDC.Street_On_Ol_2,'') &lt;&gt; ISNULL(PDC.Street_On_Ol,'') THEN ISNULL(PDC.Street_On_Ol_2,'') ELSE '' END AS Address2&#xA;        ,ISNULL(PDC.City_On_Ol,'') AS City&#xA;        ,ISNULL(PDC.State_On_Ol,'') AS State&#xA;        ,ISNULL(PDC.Zip_On_Ol,'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM PublicDetails_cte PDC WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = PDC.SSN&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'LICENSE'&#xA;                                                         AND PA.Address1 = ISNULL(PDC.Street_On_Ol,'')&#xA;                                                         AND PA.Address2 = CASE WHEN ISNULL(PDC.Street_On_Ol_2,'') &lt;&gt; ISNULL(PDC.Street_On_Ol,'') THEN ISNULL(PDC.Street_On_Ol_2,'') ELSE '' END&#xA;                                                         AND PA.City = ISNULL(PDC.City_On_Ol,'')&#xA;                                                         AND PA.State = ISNULL(PDC.State_On_Ol,'')&#xA;                                                         AND PA.Zip = ISNULL(PDC.Zip_On_Ol,'')&#xA;   WHERE ISNULL(PDC.Street_On_Ol,'')&#xA;         + ISNULL(PDC.Street_On_Ol_2,'')&#xA;         + ISNULL(PDC.City_On_Ol,'')&#xA;         + ISNULL(PDC.State_On_Ol,'')&#xA;         + ISNULL(PDC.Zip_On_Ol,'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--67,062&#xA;&#xA;&#xA;--PUBLIC INFO PHONE NUMBERS&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PUI.Phone)),'') &gt; '' AND ISNUMERIC(PUI.Phone) = 1 AND LEN(PUI.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(PUI.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PUI.SSN),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(PUI.Phone)),'') &gt; '' AND ISNUMERIC(PUI.Phone) = 1 AND LEN(PUI.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(PUI.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(PUI.Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(PUI.Phone)),'') &gt; ''&#xA;    AND LTRIM(RTRIM(CONVERT(VARCHAR(50),PUI.SSN))) != '000000000'&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--144,705&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblZipCode"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{494fec11-4d98-4f5e-8198-3450dd7d4e5e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblZipCode"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;;WITH Zip1_cte AS&#xA;      (SELECT ISNULL(LTRIM(RTRIM(CPI.City)),'') City&#xA;             ,ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPI.State))),'') State&#xA;             ,ISNULL(LTRIM(RTRIM(CPI.Zip)),'') Zip&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPI WITH (NOLOCK)&#xA;       UNION ALL&#xA;       SELECT ISNULL(LTRIM(RTRIM(PUI.City)),'') City&#xA;             ,ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PUI.State))),'') State&#xA;             ,ISNULL(LTRIM(RTRIM(PUI.Zip)),'') Zip&#xA;         FROM BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK)&#xA;       UNION ALL&#xA;       SELECT ISNULL(LTRIM(RTRIM(PD.City_On_Ol)),'') City&#xA;             ,ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),PD.State_On_Ol))),'') State&#xA;             ,ISNULL(LTRIM(RTRIM(PD.Zip_On_Ol)),'') Zip&#xA;         FROM BMLakewood_Source.dbo.Public_Details PD WITH (NOLOCK))&#xA;     ,Zip2_cte AS&#xA;      (SELECT Z1.City&#xA;             ,Z1.State&#xA;             ,Z1.Zip&#xA;         FROM Zip1_cte Z1 WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(REPLACE(Z1.Zip,'0',''))),'') &gt; ''&#xA;          AND ISNUMERIC(LTRIM(RTRIM(REPLACE(Z1.Zip,'-','')))) = 1&#xA;          AND LEN(LTRIM(RTRIM(REPLACE(Z1.Zip,'-','')))) IN (5,9)&#xA;        GROUP BY Z1.City&#xA;                ,Z1.State&#xA;                ,Z1.Zip)&#xA;INSERT INTO tblZipCode&#xA;            (ZipCode&#xA;            ,City&#xA;            ,State&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- ZipCodeID&#xA;         Z.Zip AS ZipCode&#xA;        ,ISNULL(Z.City,'') AS City&#xA;        ,ISNULL(Z.State,'') AS State&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM Zip2_cte Z WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblZipCode ZC WITH (NOLOCK) ON ZC.ZipCode = Z.Zip AND ZC.City = ISNULL(Z.City,'') AND ZC.State = ISNULL(Z.State,'')&#xA;   WHERE ZC.ZipCodeID IS NULL&#xA;--17,573&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TPO_VICTIMS_AND_COMPLAINANTS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{80a3ea2a-de9c-4354-9d61-39f0f099b4e5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="TPO_VICTIMS_AND_COMPLAINANTS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--TPO VICTIMS&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,V.DOB AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(V.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(V.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(V.Middle_Name)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'TPOV' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),V.TPO_Victim_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.TPO_Victims V WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'TPOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.TPO_Victim_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--150&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(V.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(V.Middle_Name)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(V.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.TPO_Victims V WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'TPOV' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),V.TPO_Victim_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(V.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(V.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(V.Last_Name)),'') + ISNULL(LTRIM(RTRIM(V.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--150&#xA;&#xA;&#xA;--TPO COMPLAINANTS&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,T.Complainant_DOB AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(T.ComplainantLName)) + ', ','') + ISNULL(LTRIM(RTRIM(T.ComplainantFName)) + ' ','') + ISNULL(LTRIM(RTRIM(T.ComplainantMName)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'TPOC' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),T.TPO_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.TPO T WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'TPOC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),T.TPO_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--100&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(T.ComplainantLName)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(T.ComplainantFName)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(T.ComplainantMName)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(T.ComplainantLName)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.TPO T WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'TPOC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),T.TPO_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(T.ComplainantLName)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(T.ComplainantFName)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(T.ComplainantLName)),'') + ISNULL(LTRIM(RTRIM(T.ComplainantFName)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--100&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TRUNCATE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{70c36876-ae8c-4e01-9cef-adb48925f414}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
