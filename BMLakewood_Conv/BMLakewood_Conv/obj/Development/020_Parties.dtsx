    <DTS:Executable
      DTS:refId="Package\EMPLOYMENT_AND_SCHOOL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{734f73a6-98a2-4fde-88b1-8d596b0de52b}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EMPLOYMENT_AND_SCHOOL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--PUBLIC DETAIL PROBATION&#xA;&#xA;INSERT INTO tblPartyEmployment&#xA;            (PartyID&#xA;            ,ActivityType&#xA;            ,EmployerID&#xA;            ,Name&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Position&#xA;            ,Supervisor&#xA;            ,Contact&#xA;            ,Phone&#xA;            ,Wages&#xA;            ,StartDate&#xA;            ,EndDate&#xA;            ,Comment&#xA;            ,HoursMonday&#xA;            ,HoursTuesday&#xA;            ,HoursWednesday&#xA;            ,HoursThursday&#xA;            ,HoursFriday&#xA;            ,HoursSaturday&#xA;            ,HoursSunday&#xA;            ,Outcome&#xA;            ,SpecialEducation&#xA;            ,HomeSchoolDistrict&#xA;            ,ProgramType&#xA;            ,GradeLevel&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyEmploymentID&#xA;         P.PartyID AS PartyID&#xA;        ,'EMP' AS ActivityType&#xA;        ,0 AS EmployerID&#xA;        ,LTRIM(RTRIM(PDP.Employment)) AS Name&#xA;        ,'BUSINESS' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.Employment_Address)),'') AS Address1&#xA;        ,'' AS Address2&#xA;        ,'' AS City&#xA;        ,'' AS State&#xA;        ,'' AS Zip&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.Occupation)),'') AS Position&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.Supervisor_Name)),'') AS Supervisor&#xA;        ,'' AS Contact&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PDP.Employment_Phone)),'') &gt; '' AND ISNUMERIC(PDP.Employment_Phone) = 1 AND LEN(PDP.Employment_Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(PDP.Employment_Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(PDP.Employment_Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(PDP.Employment_Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(PDP.Employment_Phone)),'')&#xA;          END AS Phone&#xA;        ,ISNULL(LTRIM(RTRIM(IL.Income_Level)),'') AS Wages&#xA;        ,NULL AS StartDate&#xA;        ,NULL AS EndDate&#xA;        ,LEFT(ISNULL('Full Time=' + CASE WHEN PDP.Full_Time = 1 THEN 'YES' ELSE 'NO' END,''),100) AS Comment&#xA;        ,'' AS HoursMonday&#xA;        ,'' AS HoursTuesday&#xA;        ,'' AS HoursWednesday&#xA;        ,'' AS HoursThursday&#xA;        ,'' AS HoursFriday&#xA;        ,'' AS HoursSaturday&#xA;        ,'' AS HoursSunday&#xA;        ,'' AS Outcome&#xA;        ,'' AS SpecialEducation&#xA;        ,'' AS HomeSchoolDistrict&#xA;        ,'' AS ProgramType&#xA;        ,ISNULL(LTRIM(RTRIM(EL.Education_Level)),'') AS GradeLevel&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Public_Detail_Probation PDP WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PDP.SSN),'')&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Education_Levels EL WITH (NOLOCK) ON EL.Education_Level_Id = PDP.Education_Level_Id&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Income_Levels IL WITH (NOLOCK) ON IL.Income_Level_Id = PDP.Income_Level_Id&#xA;         LEFT OUTER JOIN tblPartyEmployment PE WITH (NOLOCK) ON PE.PartyID = P.PartyID AND PE.ActivityType = 'EMP'&#xA;   WHERE ISNULL(LTRIM(RTRIM(Employment)),'') &gt; ''&#xA;     AND PE.PartyEmploymentID IS NULL&#xA;--1,623&#xA;&#xA;&#xA;INSERT INTO tblPartyEmployment&#xA;            (PartyID&#xA;            ,ActivityType&#xA;            ,EmployerID&#xA;            ,Name&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Position&#xA;            ,Supervisor&#xA;            ,Contact&#xA;            ,Phone&#xA;            ,Wages&#xA;            ,StartDate&#xA;            ,EndDate&#xA;            ,Comment&#xA;            ,HoursMonday&#xA;            ,HoursTuesday&#xA;            ,HoursWednesday&#xA;            ,HoursThursday&#xA;            ,HoursFriday&#xA;            ,HoursSaturday&#xA;            ,HoursSunday&#xA;            ,Outcome&#xA;            ,SpecialEducation&#xA;            ,HomeSchoolDistrict&#xA;            ,ProgramType&#xA;            ,GradeLevel&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyEmploymentID&#xA;         P.PartyID AS PartyID&#xA;        ,'SCH' AS ActivityType&#xA;        ,0 AS EmployerID&#xA;        ,LTRIM(RTRIM(PDP.School)) AS Name&#xA;        ,'BUSINESS' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(PDP.School_Address)),'') AS Address1&#xA;        ,'' AS Address2&#xA;        ,'' AS City&#xA;        ,'' AS State&#xA;        ,'' AS Zip&#xA;        ,'' AS Position&#xA;        ,'' AS Supervisor&#xA;        ,'' AS Contact&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PDP.School_Phone)),'') &gt; '' AND ISNUMERIC(PDP.School_Phone) = 1 AND LEN(PDP.School_Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(PDP.School_Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(PDP.School_Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(PDP.School_Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(PDP.School_Phone)),'')&#xA;          END AS Phone&#xA;        ,'' AS Wages&#xA;        ,NULL AS StartDate&#xA;        ,NULL AS EndDate&#xA;        ,'' AS Comment&#xA;        ,'' AS HoursMonday&#xA;        ,'' AS HoursTuesday&#xA;        ,'' AS HoursWednesday&#xA;        ,'' AS HoursThursday&#xA;        ,'' AS HoursFriday&#xA;        ,'' AS HoursSaturday&#xA;        ,'' AS HoursSunday&#xA;        ,'' AS Outcome&#xA;        ,'' AS SpecialEducation&#xA;        ,'' AS HomeSchoolDistrict&#xA;        ,'' AS ProgramType&#xA;        ,ISNULL(LTRIM(RTRIM(EL.Education_Level)),'') AS GradeLevel&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Public_Detail_Probation PDP WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),PDP.SSN),'')&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Education_Levels EL WITH (NOLOCK) ON EL.Education_Level_Id = PDP.Education_Level_Id&#xA;         LEFT OUTER JOIN tblPartyEmployment PE WITH (NOLOCK) ON PE.PartyID = P.PartyID AND PE.ActivityType = 'SCH'&#xA;   WHERE ISNULL(LTRIM(RTRIM(School)),'') &gt; ''&#xA;     AND PE.PartyEmploymentID IS NULL&#xA;--14&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
