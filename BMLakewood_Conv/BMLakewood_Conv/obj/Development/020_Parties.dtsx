  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\AGENCIES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{dcf8045f-7f74-4abd-a0f1-7d834524dbe7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="AGENCIES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(LTRIM(RTRIM(A.Agency_Code)),'') AS PartyCode&#xA;        ,'AGCY' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(A.BCI_Agency_Code)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_Name)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),A.Agency_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Agencies A WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Agency_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--20&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_Name)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(A.Agency_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Agencies A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(A.Agency_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Agency_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--20&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_Street)),'') AS Address1&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_Street2)),'') AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(A.Agency_Zip)),'') AS Zip&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(A.Agency_State)),'') &gt; '' THEN 'US' ELSE '' END AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Agencies A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(A.Agency_Street)),'')&#xA;                                                         AND PA.Address2 = ISNULL(LTRIM(RTRIM(A.Agency_Street2)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(A.Agency_City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(A.Agency_State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(A.Agency_Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Agency_Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Agency_Street2)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Agency_City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Agency_State)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Agency_Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(A.Agency_Phone)),'') &gt; '' AND ISNUMERIC(A.Agency_Phone) = 1 AND LEN(A.Agency_Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(A.Agency_Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Agencies A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(A.Agency_Phone)),'') &gt; '' AND ISNUMERIC(A.Agency_Phone) = 1 AND LEN(A.Agency_Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(A.Agency_Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(A.Agency_Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Agency_Phone)),'') &gt; ''&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--1&#xA;&#xA;&#xA;--AGENCIES - COURT INFO&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(LTRIM(RTRIM(CI.Court_Code)),'') AS PartyCode&#xA;        ,'AGCY' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Court_Code)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,ISNULL(LTRIM(RTRIM(CI.GBSSupportID)),'') AS EMailAddress&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(CI.Clerk_Of_Court_Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(CI.Clerk_Of_Court_First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(CI.Clerk_Of_Court_Middle_Initial)),''),500) AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Court_Name)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Court_Code)),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Court_Info CI WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = LTRIM(RTRIM(CI.Court_Code))&#xA;   WHERE P.PartyID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Court_Name)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(CI.Court_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Court_Info CI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = LTRIM(RTRIM(CI.Court_Code))&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = LTRIM(RTRIM(CI.Court_Name))&#xA;   WHERE PN.PartyNameID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Street)),'') AS Address1&#xA;        ,'' AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(CI.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(CI.State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(CI.Zip)),'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Court_Info CI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = LTRIM(RTRIM(CI.Court_Code))&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(CI.Street)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(CI.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(CI.State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(CI.Zip)),'')&#xA;   WHERE PA.PartyAddressID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(CI.Phone)),'') &gt; '' AND ISNUMERIC(CI.Phone) = 1 AND LEN(CI.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(CI.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Court_Info CI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = LTRIM(RTRIM(CI.Court_Code))&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(CI.Phone)),'') &gt; '' AND ISNUMERIC(CI.Phone) = 1 AND LEN(CI.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(CI.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(CI.Phone)),'')&#xA;                                                                             END&#xA;   WHERE PP.PartyPhoneID IS NULL&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(CI.Fax)),'') &gt; '' AND ISNUMERIC(CI.Fax) = 1 AND LEN(CI.Fax) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(CI.Fax)),'')&#xA;          END AS PhoneNumber&#xA;        ,'FAX' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Court_Info CI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'AGCY' AND P.WebValidation = LTRIM(RTRIM(CI.Court_Code))&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'FAX'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(CI.Fax)),'') &gt; '' AND ISNUMERIC(CI.Fax) = 1 AND LEN(CI.Fax) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(CI.Fax)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(CI.Fax)),'')&#xA;                                                                             END&#xA;   WHERE PP.PartyPhoneID IS NULL&#xA;--1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ATTORNEYS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6a79d9c5-a7d1-4362-8c71-999c851c100a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ATTORNEYS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblLookup&#xA;            (Code&#xA;            ,Description&#xA;            ,LookupGroup&#xA;            ,LookupKey&#xA;            ,UseDescription&#xA;            ,DisplayOrder&#xA;            ,OBTSCode&#xA;            ,TCATSCode&#xA;            ,SRSCode&#xA;            ,Active&#xA;            ,ICPEnabled&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,CCISCode&#xA;            ,CCOCSubType)&#xA;  SELECT -- LookupID&#xA;         'PROS' AS Code&#xA;        ,'Prosecutor' AS Description&#xA;        ,'PrimaryPartySubType' AS LookupGroup&#xA;        ,'' AS LookupKey&#xA;        ,'' AS UseDescription&#xA;        ,99999 AS DisplayOrder&#xA;        ,'' AS OBTSCode&#xA;        ,'' AS TCATSCode&#xA;        ,'' AS SRSCode&#xA;        ,1 AS Active&#xA;        ,1 AS ICPEnabled&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,'' AS CCISCode&#xA;        ,'' AS CCOCSubType&#xA;   WHERE NOT EXISTS (SELECT 1 FROM tblLookup L WITH (NOLOCK) WHERE L.LookupGroup = 'PrimaryPartySubType' AND L.Code = 'PROS')&#xA;--1&#xA;&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(LTRIM(RTRIM(A.Supreme_Court_Id)),'') AS PartyCode&#xA;        ,'ATT' AS PrimaryPartyType&#xA;        ,CASE WHEN ISNULL(PR.Prosecutor_Id,0) &gt; 0 THEN 'PROS' ELSE '' END AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,ISNULL(PAG.PartyID,0) AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,ISNULL(LTRIM(RTRIM(A.Supreme_Court_Id)),'') AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,ISNULL(LTRIM(RTRIM(A.Note)),'') AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(A.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(A.First_Name)) + ' ','') + ISNULL(LTRIM(RTRIM(A.Middle_Initial)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'') AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),A.Attorney_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Attorneys A WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Prosecutors PR WITH (NOLOCK) ON ISNULL(LTRIM(RTRIM(PR.Last_Name)),'') = ISNULL(LTRIM(RTRIM(A.Last_Name)),'')&#xA;                                                                            AND ISNULL(LTRIM(RTRIM(PR.First_Name)),'') = ISNULL(LTRIM(RTRIM(A.First_Name)),'')&#xA;         LEFT OUTER JOIN tblParty PAG WITH (NOLOCK) ON PAG.PrimaryPartyType = 'AGCY' AND PAG.WebValidation = ISNULL(CONVERT(VARCHAR(255),PR.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Attorney_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--4,922&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(A.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(A.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(A.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(A.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Attorneys A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Attorney_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(A.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(A.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Last_Name)),'') + ISNULL(LTRIM(RTRIM(A.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--4,920  (2 SOURCE ATTORNEY NAMES ARE BLANK)&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,'CURRENT' AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(A.Street)),'') AS Address1&#xA;        ,ISNULL(LTRIM(RTRIM(A.Street2)),'') AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(A.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(A.State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(A.Zip)),'') AS Zip&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(A.State)),'') &gt; '' THEN 'US' ELSE '' END AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Attorneys A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Attorney_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(A.Street)),'')&#xA;                                                         AND PA.Address2 = ISNULL(LTRIM(RTRIM(A.Street2)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(A.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(A.State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(A.Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Street2)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.State)),'')&#xA;         + ISNULL(LTRIM(RTRIM(A.Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--4815  (107 ATTORNEYS HAD BLANK ADDRESSES)&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(A.Phone)),'') &gt; '' AND ISNUMERIC(A.Phone) = 1 AND LEN(A.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(A.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(A.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(A.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(A.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,'PRIMARY' AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Attorneys A WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),A.Attorney_Id),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(A.Phone)),'') &gt; '' AND ISNUMERIC(A.Phone) = 1 AND LEN(A.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(A.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(A.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(A.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(A.Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(A.Phone)),'') &gt; ''&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--3706  (1216 ATTORNEYS HAD BLANK PHONE NUMBERS)&#xA;&#xA;&#xA;--2 PROSECUTORS NOT IN ATTORNEYS TABLE&#xA;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'ATT' AS PrimaryPartyType&#xA;        ,'PROS' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,ISNULL(PAG.PartyID,0) AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(LTRIM(RTRIM(PR.Last_Name)) + ', ','') + ISNULL(LTRIM(RTRIM(PR.First_Name)),''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'') AS FederalTaxID&#xA;        ,'' AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Prosecutors PR WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty PAG WITH (NOLOCK) ON PAG.PrimaryPartyType = 'AGCY' AND PAG.WebValidation = ISNULL(CONVERT(VARCHAR(255),PR.Agency_Id),'')&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND P.PrimaryPartySubType = 'PROS' AND P.FederalTaxID = ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--2  (PROSECUTORS NOT ALREADY IN ATTORNEYS TABLE)&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(PR.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(PR.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(PR.Middle_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(PR.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Prosecutors PR WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND PrimaryPartySubType = 'PROS' AND P.FederalTaxID = ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(PR.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(PR.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PR.Last_Name)),'') + ISNULL(LTRIM(RTRIM(PR.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--2  (PROSECUTORS NOT IN ATTORNEYS TABLE)&#xA;&#xA;&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(P.WebValidation,'') &gt; '' THEN 'BUSINESS' ELSE 'CURRENT' END AS AddressType&#xA;        ,ISNULL(LTRIM(RTRIM(PR.Street)),'') AS Address1&#xA;        ,'' AS Address2&#xA;        ,ISNULL(LTRIM(RTRIM(PR.City)),'') AS City&#xA;        ,ISNULL(LTRIM(RTRIM(PR.State)),'') AS State&#xA;        ,ISNULL(LTRIM(RTRIM(PR.Zip)),'') AS Zip&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PR.State)),'') &gt; '' THEN 'US' ELSE '' END AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Prosecutors PR WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND PrimaryPartySubType = 'PROS' AND P.FederalTaxID = ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(LTRIM(RTRIM(PR.Street)),'')&#xA;                                                         AND PA.City = ISNULL(LTRIM(RTRIM(PR.City)),'')&#xA;                                                         AND PA.State = ISNULL(LTRIM(RTRIM(PR.State)),'')&#xA;                                                         AND PA.Zip = ISNULL(LTRIM(RTRIM(PR.Zip)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(PR.Street)),'')&#xA;         + ISNULL(LTRIM(RTRIM(PR.City)),'')&#xA;         + ISNULL(LTRIM(RTRIM(PR.State)),'')&#xA;         + ISNULL(LTRIM(RTRIM(PR.Zip)),'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;--5  (2 PROSECUTORS NOT IN ATTORNEYS TABLE AND 3 NEW ADDRESSES FOR EXISTING PROSECUTORS)&#xA;&#xA;&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(PR.Phone)),'') &gt; '' AND ISNUMERIC(PR.Phone) = 1 AND LEN(PR.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(PR.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,CASE WHEN ISNULL(P.WebValidation,'') &gt; '' THEN 'SECONDARY' ELSE 'PRIMARY' END AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM BMLakewood_Source.dbo.Prosecutors PR WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'ATT' AND PrimaryPartySubType = 'PROS' AND P.FederalTaxID = ISNULL(CONVERT(VARCHAR(50),PR.Prosecutor_Id),'')&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(PR.Phone)),'') &gt; '' AND ISNUMERIC(PR.Phone) = 1 AND LEN(PR.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(PR.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(PR.Phone)),'')&#xA;                                                                             END&#xA;   WHERE ISNULL(LTRIM(RTRIM(PR.Phone)),'') &gt; ''&#xA;     AND PP.PartyPhoneID IS NULL&#xA;--4  (2 PROSECUTORS NOT IN ATTORNEYS TABLE AND 2 NEW PHONE NUMBERS FOR EXISTING PROSECUTORS)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\BOND_AGENCIES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7f9439f6-7722-4d75-9288-2ae1756146b1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="BOND_AGENCIES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         ISNULL(LTRIM(RTRIM(B.License_Number)),'') AS PartyCode&#xA;        ,'BD' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(B.License_Number)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(B.Bond_Agency_Name)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),B.Bond_Agency_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Bond_Agencies B WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'BD' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),B.Bond_Agency_Id),'')&#xA;   WHERE P.PartyID IS NULL&#xA;--13&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(B.Bond_Agency_Name)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(B.Bond_Agency_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Bond_Agencies B WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'BD' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),B.Bond_Agency_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(B.Bond_Agency_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(B.Bond_Agency_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--13&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CASE_PUBLIC_INFO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0008c6db-7309-42c3-b7f7-c410b36ffce1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CASE_PUBLIC_INFO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--CASE PUBLIC INFO NOT ALREADY IN PUBLIC INFO&#xA;&#xA;;WITH CasePublicInfo_cte AS&#xA;      (SELECT CONVERT(VARCHAR(50),CPUI.SSN) SSN&#xA;             ,LTRIM(RTRIM(CPUI.Last_Name)) Last_Name&#xA;             ,LTRIM(RTRIM(CPUI.First_Name)) First_Name&#xA;             ,LTRIM(RTRIM(CPUI.Middle_Initial)) Middle_Initial&#xA;             ,CPUI.Birth_Date&#xA;             ,LTRIM(RTRIM(CPUI.Case_Number)) Case_Number&#xA;             ,ROW_NUMBER() OVER(PARTITION BY CONVERT(VARCHAR(50),CPUI.SSN) ORDER BY LTRIM(RTRIM(CPUI.Case_Number)) DESC) AS SeqNbr&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPUI WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))),'') &gt; '')&#xA;&#x9;&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         '' AS PartyCode&#xA;        ,'' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,CPI.Birth_Date AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,CASE WHEN ISNULL(CPI.SSN,'') &gt; '' AND ISNUMERIC(ISNULL(CPI.SSN,'')) = 1 AND LEN(ISNULL(CPI.SSN,'')) = 9&#xA;              THEN dbo.fnFormatSSN(ISNULL(CPI.SSN,''))&#xA;              ELSE ''&#xA;          END AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,'' AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,'' AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,'' AS UserLogin&#xA;        ,0 AS UserActive&#xA;        ,0 AS UserRoleID&#xA;        ,'' AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,LEFT(ISNULL(CPI.Last_Name + ', ','') + ISNULL(CPI.First_Name + ' ','') + ISNULL(CPI.Middle_Initial,''),500) AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,'PUBLIC' AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CPI.SSN,'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM CasePublicInfo_cte CPI WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = CPI.SSN&#xA;   WHERE CPI.SeqNbr = 1&#xA;     AND P.PartyID IS NULL&#xA;--1&#xA;&#xA;&#xA;--CASE PUBLIC INFO NAMES NOT ALREADY IN PUBLIC INFO&#xA;&#xA;;WITH CasePublicInfo_cte AS&#xA;      (SELECT DISTINCT&#xA;              CONVERT(VARCHAR(50),CPUI.SSN) SSN&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Last_Name)),'') Last_Name&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.First_Name)),'') First_Name&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Middle_Initial)),'') Middle_Initial&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Title)),'') Title&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPUI WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))),'') &gt; ''&#xA;        AND LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))) != '000000000')&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(CPI.Last_Name,'') AS LastOrBusinessName&#xA;        ,ISNULL(CPI.First_Name,'') AS FirstName&#xA;        ,ISNULL(CPI.Middle_Initial,'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,ISNULL(CPI.Title,'') AS SuffixName&#xA;        ,CASE WHEN ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') &gt; ''  THEN 1 ELSE 0 END AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(CPI.Last_Name,''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM CasePublicInfo_cte CPI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = CPI.SSN&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK) ON ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') = CPI.SSN&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID&#xA;                                                      AND PN.PartyNameType = 0&#xA;                                                      AND PN.LastOrBusinessName = ISNULL(CPI.Last_Name,'')&#xA;                                                      AND PN.FirstName = ISNULL(CPI.First_Name,'')&#xA;                                                      AND PN.MiddleName = ISNULL(CPI.Middle_Initial,'')&#xA;         LEFT OUTER JOIN tblPartyName PN1 WITH (NOLOCK) ON PN1.PartyID = P.PartyID&#xA;                                                       AND PN1.PartyNameType = 1&#xA;                                                       AND PN1.LastOrBusinessName = ISNULL(CPI.Last_Name,'')&#xA;                                                       AND PN1.FirstName = ISNULL(CPI.First_Name,'')&#xA;                                                       AND PN1.MiddleName = ISNULL(CPI.Middle_Initial,'')&#xA;   WHERE ISNULL(CPI.Last_Name,'') + ISNULL(CPI.First_Name,'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;     AND PN1.PartyNameID IS NULL&#xA;--6,320  (1 NEW 0-PRIMARY AND 6,316 NEW 1-AKA)&#xA;&#xA;&#xA;--CASE PUBLIC INFO DBA NAMES NOT ALREADY IN PUBLIC INFO&#xA;&#xA;;WITH CasePublicInfo_cte AS&#xA;      (SELECT DISTINCT&#xA;              CONVERT(VARCHAR(50),CPUI.SSN) SSN&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.DBA)),'') DBA&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPUI WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))),'') &gt; ''&#xA;          AND LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))) != '000000000'&#xA;          AND ISNULL(LTRIM(RTRIM(CPUI.DBA)),'') &gt; '')&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(CPI.DBA,'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,4 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(CPI.DBA,''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM CasePublicInfo_cte CPI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = CPI.SSN&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID&#xA;                                                      AND PN.PartyNameType = 4&#xA;                                                      AND PN.LastOrBusinessName = ISNULL(CPI.DBA,'')&#xA;   WHERE PN.PartyNameID IS NULL&#xA;--1&#xA;&#xA;&#xA;--CASE PUBLIC INFO ADDRESSES NOT ALREADY IN PUBLIC INFO&#xA;&#xA;INSERT INTO tblLookup&#xA;            (Code&#xA;            ,Description&#xA;            ,LookupGroup&#xA;            ,LookupKey&#xA;            ,UseDescription&#xA;            ,DisplayOrder&#xA;            ,OBTSCode&#xA;            ,TCATSCode&#xA;            ,SRSCode&#xA;            ,Active&#xA;            ,ICPEnabled&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,CCISCode&#xA;            ,CCOCSubType)&#xA;  SELECT -- LookupID&#xA;         'OTHER' AS Code&#xA;        ,'Other Address' AS Description&#xA;        ,'AddressType' AS LookupGroup&#xA;        ,'' AS LookupKey&#xA;        ,'' AS UseDescription&#xA;        ,99999 AS DisplayOrder&#xA;        ,'' AS OBTSCode&#xA;        ,'' AS TCATSCode&#xA;        ,'' AS SRSCode&#xA;        ,1 AS Active&#xA;        ,1 AS ICPEnabled&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,'' AS CCISCode&#xA;        ,'' AS CCOCSubType&#xA;   WHERE NOT EXISTS (SELECT 1 FROM tblLookup L WITH (NOLOCK) WHERE L.LookupGroup = 'AddressType' AND L.Code = 'OTHER')&#xA;--1&#xA;&#xA;&#xA;;WITH CasePublicInfo_cte AS&#xA;      (SELECT DISTINCT&#xA;              CONVERT(VARCHAR(50),CPUI.SSN) SSN&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Street)),'') Street&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Street2)),'') Street2&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.City)),'') City&#xA;             ,ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.State))),'') State&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Zip)),'') Zip&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPUI WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))),'') &gt; '' &#xA;        AND LTRIM(RTRIM(CONVERT(VARCHAR,CPUI.SSN))) != '000000000')&#xA;INSERT INTO tblPartyAddress&#xA;            (PartyID&#xA;            ,AddressType&#xA;            ,Address1&#xA;            ,Address2&#xA;            ,City&#xA;            ,State&#xA;            ,Zip&#xA;            ,Country&#xA;            ,Active&#xA;            ,Confidential&#xA;            ,CreatedWithinCaseID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyAddressID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') &gt; '' THEN 'OTHER' ELSE 'CURRENT' END AS AddressType&#xA;        ,ISNULL(CPI.Street,'') AS Address1&#xA;        ,CASE WHEN ISNULL(CPI.Street2,'') &lt;&gt; ISNULL(CPI.Street,'') THEN ISNULL(CPI.Street2,'') ELSE '' END AS Address2&#xA;        ,ISNULL(CPI.City,'') AS City&#xA;        ,ISNULL(CPI.State,'') AS State&#xA;        ,ISNULL(CPI.Zip,'') AS Zip&#xA;        ,'US' AS Country&#xA;        ,1 AS Active&#xA;        ,0 AS Confidential&#xA;        ,0 AS CreatedWithinCaseID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM CasePublicInfo_cte CPI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = CPI.SSN&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK) ON ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') = CPI.SSN&#xA;         LEFT OUTER JOIN tblPartyAddress PA WITH (NOLOCK) ON PA.PartyID = P.PartyID&#xA;                                                         AND PA.AddressType = 'CURRENT'&#xA;                                                         AND PA.Address1 = ISNULL(CPI.Street,'')&#xA;                                                         AND PA.Address2 = CASE WHEN ISNULL(CPI.Street2,'') &lt;&gt; ISNULL(CPI.Street,'') THEN ISNULL(CPI.Street2,'') ELSE '' END&#xA;                                                         AND PA.City = ISNULL(CPI.City,'')&#xA;                                                         AND PA.State = ISNULL(CPI.State,'')&#xA;                                                         AND PA.Zip = ISNULL(CPI.Zip,'')&#xA;         LEFT OUTER JOIN tblPartyAddress PA2 WITH (NOLOCK) ON PA2.PartyID = P.PartyID&#xA;                                                         AND PA2.AddressType = 'OTHER'&#xA;                                                         AND PA2.Address1 = ISNULL(CPI.Street,'')&#xA;                                                         AND PA2.Address2 = CASE WHEN ISNULL(CPI.Street2,'') &lt;&gt; ISNULL(CPI.Street,'') THEN ISNULL(CPI.Street2,'') ELSE '' END&#xA;                                                         AND PA2.City = ISNULL(CPI.City,'')&#xA;                                                         AND PA2.State = ISNULL(CPI.State,'')&#xA;                                                         AND PA2.Zip = ISNULL(CPI.Zip,'')&#xA;   WHERE ISNULL(CPI.Street,'')&#xA;         + ISNULL(CPI.Street2,'')&#xA;         + ISNULL(CPI.City,'')&#xA;         + ISNULL(CPI.State,'')&#xA;         + ISNULL(CPI.Zip,'') &gt; ''&#xA;     AND PA.PartyAddressID IS NULL&#xA;     AND PA2.PartyAddressID IS NULL&#xA;--29,997&#xA;&#xA;&#xA;--CASE PUBLIC INFO PHONE NUMBERS NOT ALREADY IN PUBLIC INFO&#xA;&#xA;;WITH CasePublicInfo_cte AS&#xA;      (SELECT DISTINCT&#xA;              CONVERT(VARCHAR(50),CPUI.SSN) SSN&#xA;             ,ISNULL(LTRIM(RTRIM(CPUI.Phone)),'') Phone&#xA;         FROM BMLakewood_Source.dbo.Case_Public_Info CPUI WITH (NOLOCK)&#xA;        WHERE ISNULL(LTRIM(RTRIM(CONVERT(VARCHAR(50),CPUI.SSN))),'') &gt; '' &#xA;          AND LTRIM(RTRIM(CONVERT(VARCHAR,CPUI.SSN))) != '000000000'&#xA;          AND ISNULL(LTRIM(RTRIM(CPUI.Phone)),'') &gt; '')&#xA;INSERT INTO tblPartyPhone&#xA;            (PartyID&#xA;            ,PhoneNumber&#xA;            ,PhoneType&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Optin&#xA;            ,OptOutDate)&#xA;  SELECT -- PartyPhoneID&#xA;         P.PartyID AS PartyID&#xA;        ,CASE WHEN ISNULL(LTRIM(RTRIM(CPI.Phone)),'') &gt; '' AND ISNUMERIC(CPI.Phone) = 1 AND LEN(CPI.Phone) = 10&#xA;              THEN '(' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),1,3)&#xA;                 + ') ' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),4,3)&#xA;                 + '-' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),7,4)&#xA;              ELSE ISNULL(LTRIM(RTRIM(CPI.Phone)),'')&#xA;          END AS PhoneNumber&#xA;        ,CASE WHEN ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') &gt; '' THEN 'OTHER' ELSE 'PRIMARY' END AS PhoneType&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS Optin&#xA;        ,NULL AS OptOutDate&#xA;    FROM CasePublicInfo_cte CPI WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.FamilyCode = 'PUBLIC' AND P.WebValidation = ISNULL(CONVERT(VARCHAR(255),CPI.SSN),'')&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Public_Info PUI WITH (NOLOCK) ON ISNULL(CONVERT(VARCHAR(50),PUI.SSN),'') = CPI.SSN&#xA;         LEFT OUTER JOIN tblPartyPhone PP WITH (NOLOCK) ON PP.PartyID = P.PartyID&#xA;                                                       AND PP.PhoneType = 'PRIMARY'&#xA;                                                       AND PP.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(CPI.Phone)),'') &gt; '' AND ISNUMERIC(CPI.Phone) = 1 AND LEN(CPI.Phone) = 10&#xA;                                                                                 THEN '(' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),1,3)&#xA;                                                                                    + ') ' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),4,3)&#xA;                                                                                    + '-' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),7,4)&#xA;                                                                                 ELSE ISNULL(LTRIM(RTRIM(CPI.Phone)),'')&#xA;                                                                             END&#xA;         LEFT OUTER JOIN tblPartyPhone PP2 WITH (NOLOCK) ON PP2.PartyID = P.PartyID&#xA;                                                        AND PP2.PhoneType = 'OTHER'&#xA;                                                        AND PP2.PhoneNumber = CASE WHEN ISNULL(LTRIM(RTRIM(CPI.Phone)),'') &gt; '' AND ISNUMERIC(CPI.Phone) = 1 AND LEN(CPI.Phone) = 10&#xA;                                                                                  THEN '(' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),1,3)&#xA;                                                                                     + ') ' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),4,3)&#xA;                                                                                     + '-' + SUBSTRING(LTRIM(RTRIM(CPI.Phone)),7,4)&#xA;                                                                                  ELSE ISNULL(LTRIM(RTRIM(CPI.Phone)),'')&#xA;                                                                              END&#xA;   WHERE PP.PartyPhoneID IS NULL&#xA;     AND PP2.PartyPhoneID IS NULL&#xA;--16,129&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CLERK_USERS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{983e7d3a-fc73-4519-b9b5-f716c30e8278}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CLERK_USERS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblParty&#xA;            (PartyCode&#xA;            ,PrimaryPartyType&#xA;            ,PrimaryPartySubType&#xA;            ,Employer&#xA;            ,AgencyID&#xA;            ,DivisionID&#xA;            ,DepartmentID&#xA;            ,Active&#xA;            ,DOB&#xA;            ,DOD&#xA;            ,Gender&#xA;            ,HairColor&#xA;            ,EyeColor&#xA;            ,SSN&#xA;            ,Classification&#xA;            ,DriversLicenseNumber&#xA;            ,DriversLicenseState&#xA;            ,DriversLicenseClass&#xA;            ,DriversLicenseExpirationYear&#xA;            ,DLOverride&#xA;            ,Height&#xA;            ,Weight&#xA;            ,IdentifyingCharacteristics&#xA;            ,Race&#xA;            ,CountryOfBirth&#xA;            ,CountryOfCitizenship&#xA;            ,USCitizen&#xA;            ,NeedsInterpreterLanguage&#xA;            ,StateIDNumber&#xA;            ,DOCNumber&#xA;            ,FBINumber&#xA;            ,BarNumber&#xA;            ,ORINumber&#xA;            ,BadgeNumber&#xA;            ,Comments&#xA;            ,EMailAddress&#xA;            ,ContactName&#xA;            ,SignatureFile&#xA;            ,DefaultParentPartyID&#xA;            ,MergedToPartyID&#xA;            ,UserLogin&#xA;            ,UserActive&#xA;            ,UserRoleID&#xA;            ,UserPassword&#xA;            ,UserLoginCount&#xA;            ,UserGUID&#xA;            ,UserLastLogin&#xA;            ,UserDefaultCheckoutLocation&#xA;            ,UserAutoLoginCode&#xA;            ,PIACallDate&#xA;            ,ShowInBatchScan&#xA;            ,CountyBranchID&#xA;            ,EscrowAccountID&#xA;            ,ICPConnection&#xA;            ,ICPEmail&#xA;            ,InmateID&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,Name&#xA;            ,PasswordLastModified&#xA;            ,PasswordMinimumLength&#xA;            ,PasswordMaximumLength&#xA;            ,PasswordDigitRequired&#xA;            ,PasswordLetterRequired&#xA;            ,PasswordSpecialCharacterRequired&#xA;            ,PasswordDuplicateControlCount&#xA;            ,PasswordExpiredDays&#xA;            ,eCitationAgencyMap&#xA;            ,JailAgencyMap&#xA;            ,PartyAlertCode&#xA;            ,BondInsurancePartyID&#xA;            ,FamilyCode&#xA;            ,DNAObtainedDate&#xA;            ,OriginalORASDate&#xA;            ,RiskAssessmentLevel&#xA;            ,CityOfBirth&#xA;            ,StateOfBirth&#xA;            ,FederalTaxID&#xA;            ,WebValidation&#xA;            ,WebValidationExpiration&#xA;            ,Ethnicity)&#xA;  SELECT -- PartyID&#xA;         SUBSTRING(LTRIM(RTRIM(U.User_Name)),1,3) AS PartyCode&#xA;        ,'CLK' AS PrimaryPartyType&#xA;        ,'' AS PrimaryPartySubType&#xA;        ,'' AS Employer&#xA;        ,0 AS AgencyID&#xA;        ,0 AS DivisionID&#xA;        ,0 AS DepartmentID&#xA;        ,1 AS Active&#xA;        ,NULL AS DOB&#xA;        ,NULL AS DOD&#xA;        ,'' AS Gender&#xA;        ,'' AS HairColor&#xA;        ,'' AS EyeColor&#xA;        ,'' AS SSN&#xA;        ,'' AS Classification&#xA;        ,'' AS DriversLicenseNumber&#xA;        ,'' AS DriversLicenseState&#xA;        ,'' AS DriversLicenseClass&#xA;        ,0 AS DriversLicenseExpirationYear&#xA;        ,0 AS DLOverride&#xA;        ,'' AS Height&#xA;        ,'' AS Weight&#xA;        ,'' AS IdentifyingCharacteristics&#xA;        ,'' AS Race&#xA;        ,'' AS CountryOfBirth&#xA;        ,'' AS CountryOfCitizenship&#xA;        ,'' AS USCitizen&#xA;        ,'' AS NeedsInterpreterLanguage&#xA;        ,ISNULL(LTRIM(RTRIM(U.BCI_Employee_Id)),'') AS StateIDNumber&#xA;        ,'' AS DOCNumber&#xA;        ,'' AS FBINumber&#xA;        ,'' AS BarNumber&#xA;        ,'' AS ORINumber&#xA;        ,'' AS BadgeNumber&#xA;        ,LTRIM(RTRIM(G.Group_Name)) AS Comments&#xA;        ,'' AS EMailAddress&#xA;        ,'' AS ContactName&#xA;        ,NULL AS SignatureFile&#xA;        ,0 AS DefaultParentPartyID&#xA;        ,0 AS MergedToPartyID&#xA;        ,LTRIM(RTRIM(U.User_Name)) AS UserLogin&#xA;        ,1 AS UserActive&#xA;        ,1 AS UserRoleID&#xA;        ,LEFT(LTRIM(RTRIM(U.User_Name)) + '123',50) AS UserPassword&#xA;        ,0 AS UserLoginCount&#xA;        ,0 AS UserGUID&#xA;        ,NULL AS UserLastLogin&#xA;        ,'' AS UserDefaultCheckoutLocation&#xA;        ,'' AS UserAutoLoginCode&#xA;        ,NULL AS PIACallDate&#xA;        ,0 AS ShowInBatchScan&#xA;        ,0 AS CountyBranchID&#xA;        ,0 AS EscrowAccountID&#xA;        ,0 AS ICPConnection&#xA;        ,0 AS ICPEmail&#xA;        ,'' AS InmateID&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,ISNULL(LTRIM(RTRIM(U.Note)),'') AS Name&#xA;        ,NULL AS PasswordLastModified&#xA;        ,0 AS PasswordMinimumLength&#xA;        ,0 AS PasswordMaximumLength&#xA;        ,0 AS PasswordDigitRequired&#xA;        ,0 AS PasswordLetterRequired&#xA;        ,0 AS PasswordSpecialCharacterRequired&#xA;        ,0 AS PasswordDuplicateControlCount&#xA;        ,0 AS PasswordExpiredDays&#xA;        ,'' AS eCitationAgencyMap&#xA;        ,'' AS JailAgencyMap&#xA;        ,'' AS PartyAlertCode&#xA;        ,0 AS BondInsurancePartyID&#xA;        ,ISNULL(CONVERT(VARCHAR(50),U.User_Id),'') AS FamilyCode&#xA;        ,NULL AS DNAObtainedDate&#xA;        ,NULL AS OriginalORASDate&#xA;        ,'' AS RiskAssessmentLevel&#xA;        ,'' AS CityOfBirth&#xA;        ,'' AS StateOfBirth&#xA;        ,'' AS FederalTaxID&#xA;        ,ISNULL(CONVERT(VARCHAR(255),U.User_Id),'') AS WebValidation&#xA;        ,NULL AS WebValidationExpiration&#xA;        ,'' AS Ethnicity&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Groups G WITH (NOLOCK) ON G.Group_Id = U.Group_Id&#xA;         LEFT OUTER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'CLK' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.User_Name)),'') &gt; ''&#xA;     AND LTRIM(RTRIM(G.Group_Name)) &lt;&gt; 'Judges'  --JUDGES WILL BE DONE SEPARATELY&#xA;     AND P.PartyID IS NULL&#xA;--132 (OUT OF 138 - 6 JUDGES WILL BE DONE SEPARATELY)&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AS LastOrBusinessName&#xA;        ,ISNULL(LTRIM(RTRIM(U.First_Name)),'') AS FirstName&#xA;        ,ISNULL(LTRIM(RTRIM(U.User_Initial)),'') AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,0 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Last_Name)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'CLK' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 0 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Last_Name)),'') AND PN.FirstName = ISNULL(LTRIM(RTRIM(U.First_Name)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Last_Name)),'') + ISNULL(LTRIM(RTRIM(U.First_Name)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--132&#xA;&#xA;&#xA;INSERT INTO tblPartyName&#xA;            (PartyID&#xA;            ,LastOrBusinessName&#xA;            ,FirstName&#xA;            ,MiddleName&#xA;            ,PrefixName&#xA;            ,SuffixName&#xA;            ,PartyNameType&#xA;            ,SoundexCode&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate)&#xA;  SELECT -- PartyNameID&#xA;         P.PartyID AS PartyID&#xA;        ,ISNULL(LTRIM(RTRIM(U.Note)),'') AS LastOrBusinessName&#xA;        ,'' AS FirstName&#xA;        ,'' AS MiddleName&#xA;        ,'' AS PrefixName&#xA;        ,'' AS SuffixName&#xA;        ,1 AS PartyNameType&#xA;        ,UPPER(SOUNDEX(ISNULL(LTRIM(RTRIM(U.Note)),''))) AS SoundexCode&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;    FROM BMLakewood_Source.dbo.Users U WITH (NOLOCK)&#xA;         INNER JOIN tblParty P WITH (NOLOCK) ON P.PrimaryPartyType = 'CLK' AND P.FamilyCode = ISNULL(CONVERT(VARCHAR(50),U.User_Id),'')&#xA;         LEFT OUTER JOIN tblPartyName PN WITH (NOLOCK) ON PN.PartyID = P.PartyID AND PN.PartyNameType = 1 AND PN.LastOrBusinessName = ISNULL(LTRIM(RTRIM(U.Note)),'')&#xA;   WHERE ISNULL(LTRIM(RTRIM(U.Note)),'') &gt; ''&#xA;     AND PN.PartyNameID IS NULL&#xA;--130&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CREATE TEMP TABLES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
