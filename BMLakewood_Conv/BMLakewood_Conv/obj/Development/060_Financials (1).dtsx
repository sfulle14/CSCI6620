          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblGLDetail&#xA;           (TransactionDetailID&#xA;           ,FeeDisbursementID&#xA;           ,CaseFeeDisbursementID&#xA;           ,MasterGLID&#xA;           ,CaseBondID&#xA;           ,DisburseAmount&#xA;           ,DebitAmount&#xA;           ,CreditAmount&#xA;           ,TransactionPaymentID&#xA;           ,CashierID&#xA;           ,CashierDate&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,AgencyCheckCreatedDate&#xA;           ,CheckID)&#xA;SELECT&#xA;           NULL AS TransactionDetailID&#xA;           ,NULL AS FeeDisbursementID&#xA;           ,NULL AS CaseFeeDisbursementID&#xA;           ,NULL AS MasterGLID&#xA;           ,NULL AS CaseBondID&#xA;           ,NULL AS DisburseAmount&#xA;           ,NULL AS DebitAmount&#xA;           ,NULL AS CreditAmount&#xA;           ,NULL AS TransactionPaymentID&#xA;           ,NULL AS CashierID&#xA;           ,NULL AS CashierDate&#xA;           ,NULL AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,NULL AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS AgencyCheckCreatedDate&#xA;           ,NULL AS CheckID&#xA;FROM &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
