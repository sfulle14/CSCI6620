    <DTS:Executable
      DTS:refId="Package\tblMasterAccount"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{573C7FE6-0D96-4839-98AD-0621E6B0032D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblMasterAccount"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblMasterAccount&#xA;&#x9;(AccountNumber&#xA;&#x9;,AccountDescription&#xA;&#x9;,AccountType&#xA;&#x9;,SubAccountType&#xA;&#x9;,DefaultDebit&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate)&#xA;SELECT&#xA;&#x9;CONVERT(VARCHAR,A.Account_Id ) AS AccountNumber&#xA;&#x9;,A.Account AS AccountDescription&#xA;&#x9;,'N' AS AccountType&#xA;&#x9;,'Type: ' + A.Type + '    ' + 'Section: ' + A.Section AS SubAccountType&#xA;&#x9;,0 AS DefaultDebit&#xA;&#x9;,1 AS CreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;FROM BMLakewood_Source.dbo.Accounts A WITH (NOLOCK)&#xA;WHERE CONVERT(VARCHAR,A.Account_Id) NOT IN (SELECT MA.AccountNumber FROM tblMasterAccount MA)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblMasterFund"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{A667A311-0072-4668-AE05-48FBA18A4802}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblMasterFund"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblMasterFund&#xA;&#x9;(BankID&#x9;&#xA;&#x9;,FundNumber&#xA;&#x9;,FundDescription&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate)&#xA;SELECT&#xA;&#x9;BA.Bank_Account_Id AS BankID&#xA;&#x9;,BA.Bank_Account AS FundNumber&#xA;&#x9;,BA.Section AS FundDescription&#xA;&#x9;,1 AS CreateBYUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;FROM BMLakewood_Source.dbo.Bank_Accounts BA WITH (NOLOCK)&#xA;WHERE BA.Bank_Account_Id NOT IN (SELECT MF.BankID FROM tblMasterFund MF )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblMasterGL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{AA129CF6-884E-40BC-A557-49937CE2858D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblMasterGL"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblMasterGL&#xA;&#x9;(GLCode&#xA;&#x9;,MasterFundID&#xA;&#x9;,MasterAccountID&#xA;&#x9;,OffsetMasterGLID&#xA;&#x9;,MergeToMasterGLID&#xA;&#x9;,GLDescription&#xA;&#x9;,Active&#xA;&#x9;,PayeeName&#xA;&#x9;,DORSection&#xA;&#x9;,DORLineItem&#xA;&#x9;,ArticleVFeeType&#xA;&#x9;,MandatoryDiscretionary&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;&#x9;,PaymentPriority&#xA;&#x9;,DORLineCode&#xA;&#x9;,AgencyID&#xA;&#x9;,CheckAccountID&#xA;&#x9;,HoldingAccount&#xA;&#x9;,AgencyYearlyPayAmount&#xA;&#x9;,PayAmountExceededAgencyID&#xA;&#x9;,AgencyCheckStartDate)&#xA;SELECT&#xA;&#x9;MA.AccountDescription AS GLCode&#xA;&#x9;,MF.MasterFundID AS MasterFundID&#xA;&#x9;,MA.MasterAccountID AS MasterAccountID&#xA;&#x9;,NULL AS OffsetMasterGLID&#xA;&#x9;,NULL AS MergeToMasterGLID&#xA;&#x9;,MA.AccountDescription AS GLDescription&#xA;&#x9;,1 AS Active&#xA;&#x9;,A.Payee_Id AS PayeeName&#xA;&#x9;,NULL AS DORSection&#xA;&#x9;,NULL AS DORLineItem&#xA;&#x9;,0 AS ArticleVFeeType&#xA;&#x9;,NULL AS MandatoryDiscretionary&#xA;&#x9;,1 AS CreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;&#x9;,1 AS PaymentPriority&#xA;&#x9;,NULL AS DORLineCode&#xA;&#x9;,A.Agency_Id AS AgencyID&#xA;&#x9;,NULL AS CheckAccountID&#xA;&#x9;,NULL AS HoldingAccount&#xA;&#x9;,NULL AS AgencyYearlyPayAmount&#xA;&#x9;,NULL AS PayAmountExceededAgencyID&#xA;&#x9;,NULL AS AgencyCheckStartDate&#xA;FROM tblMasterAccount MA WITH (NOLOCK)&#xA;&#x9;LEFT OUTER JOIN BMLakewood_Source.dbo.Accounts A WITH (NOLOCK) ON A.Account = MA.AccountDescription&#xA;&#x9;LEFT OUTER JOIN tblMasterFund MF WITH (NOLOCK) ON MF.BankID = A.Bank_Account_Id&#xA;WHERE MA.AccountDescription NOT IN (SELECT MGL.GLCode FROM tblMasterGL MGL)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblRestitution"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{fc9fb966-f634-4205-89c6-d4e9190073cb}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblRestitution"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblRestitution&#xA;           (TotalRestitutionAmount&#xA;           ,TotalAmountPaid&#xA;           ,TotalAmountOutstanding&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate)&#xA;&#xA;SELECT&#xA;           CF.RestitutionTotalFee  AS TotalRestitutionAmount&#xA;           ,CF.RestitutionAmountPaid AS TotalAmountPaid&#xA;           ,CF.RestitutionAmountOutstanding AS TotalAmountOutstanding&#xA;           ,CF.CreateByUserID AS CreateByUserID&#xA;           ,CF.CreateDate AS CreateDate&#xA;           ,CF.ModifyByUserID AS ModifyByUserID&#xA;           ,CF.ModifyDate AS ModifyDate&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA;WHERE FeeId = 65&#xA;ORDER BY CF.RestitutionID&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblRestitutionDetail"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{f237cf2a-eff1-49be-b211-7e6fa317fa91}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblRestitutionDetail"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblRestitutionDetail&#xA;           (RestitutionID&#xA;           ,PartyID&#xA;           ,RestitutionType&#xA;           ,RestitutionAmount&#xA;           ,AmountPaid&#xA;           ,AmountOutstanding&#xA;           ,BadCheckNumber&#xA;           ,BadCheckDate&#xA;           ,BadCheckAmount&#xA;           ,PaymentPriority&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate)&#xA;SELECT&#xA;           CF.RestitutionID AS RestitutionID&#xA;           ,CP.PartyID AS PartyID&#xA;           ,'VICTIM' AS RestitutionType&#xA;           ,CF.RestitutionTotalFee AS RestitutionAmount&#xA;           ,CF.RestitutionAmountPaid AS AmountPaid&#xA;           ,(CF.RestitutionTotalFee - CF.RestitutionAmountPaid) AS AmountOutstanding&#xA;           ,NULL AS BadCheckNumber&#xA;           ,NULL AS BadCheckDate&#xA;           ,NULL AS BadCheckAmount&#xA;           ,NULL AS PaymentPriority&#xA;           ,CF.CreateByUserID AS CreateByUserID&#xA;           ,CF.CreateDate AS CreateDate&#xA;           ,CF.ModifyByUserID AS ModifyByUserID&#xA;           ,CF.ModifyDate AS ModifyDate&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA;&#x9;LEFT JOIN tblCaseParty CP WITH (NOLOCK) ON CP.CaseID = CF.CaseID AND CP.CasePartyType = 'VIC'&#xA;WHERE FeeID = 65&#xA;ORDER BY CF.RestitutionID&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
