    <DTS:Executable
      DTS:refId="Package\tblTransactionPayment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{95ebbe29-50c1-4473-9adf-1f45b8bf645a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblTransactionPayment"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblTransactionPayment&#xA;           ([TransactionID]&#xA;           ,[PaymentTypeID]&#xA;           ,[PaymentAmountTendered]&#xA;           ,[PaymentAmount]&#xA;           ,[Refund]&#xA;           ,[Change]&#xA;           ,[Overage]&#xA;           ,[ReferenceNumber]&#xA;           ,[FromBankID]&#xA;           ,[CaseBondID]&#xA;           ,[RestitutionID]&#xA;           ,[MasterGLID]&#xA;           ,[CashierByUserID]&#xA;           ,[CashierDate]&#xA;           ,[CloseoutID]&#xA;           ,[Info]&#xA;           ,[CreditCardSignature]&#xA;           ,[Status]&#xA;           ,[VoidDate]&#xA;           ,[VoidByUserID]&#xA;           ,[EscrowAccountID]&#xA;           ,[CheckName]&#xA;           ,[CheckPartyID]&#xA;           ,[DoNotApply]&#xA;           ,[CreditCardFee]&#xA;           ,[CreateByUserID]&#xA;           ,[CreateDate]&#xA;           ,[ModifyByUserID]&#xA;           ,[ModifyDate]&#xA;           ,[SplitFromTransactionPaymentID])&#xA;SELECT&#xA;            NULL AS [TransactionID]&#xA;           ,Case WHEN CR.Payment_Mode_Id IN (1,12, 13, 11) THEN 1&#xA;&#x9;  WHEN CR.Payment_Mode_Id IN (2,20,36,15) THEN 2&#xA;&#x9;  WHEN CR.Payment_Mode_Id IN (4) THEN 4&#xA;&#x9;  WHEN CR.Payment_Mode_Id IN (5) THEN 5&#xA;&#x9;  END AS [PaymentTypeID]&#xA;           ,NULL AS [PaymentAmountTendered]&#xA;           ,NULL AS [PaymentAmount]&#xA;           ,NULL AS [Refund]&#xA;           ,NULL AS [Change]&#xA;           ,NULL AS [Overage]&#xA;           ,NULL AS [ReferenceNumber]&#xA;           ,NULL AS [FromBankID]&#xA;           ,NULL AS [CaseBondID]&#xA;           ,NULL AS [RestitutionID]&#xA;           ,NULL AS [MasterGLID]&#xA;           ,NULL AS [CashierByUserID]&#xA;           ,NULL AS [CashierDate]&#xA;           ,NULL AS [CloseoutID]&#xA;           ,NULL AS [Info]&#xA;           ,NULL AS [CreditCardSignature]&#xA;           ,NULL AS [Status]&#xA;           ,NULL AS [VoidDate]&#xA;           ,NULL AS [VoidByUserID]&#xA;           ,NULL AS [EscrowAccountID]&#xA;           ,NULL AS [CheckName]&#xA;           ,NULL AS [CheckPartyID]&#xA;           ,NULL AS [DoNotApply]&#xA;           ,NULL AS [CreditCardFee]&#xA;           ,NULL AS [CreateByUserID]&#xA;           ,NULL AS [CreateDate]&#xA;           ,NULL AS [ModifyByUserID]&#xA;           ,NULL AS [ModifyDate]&#xA;           ,NULL AS [SplitFromTransactionPaymentID]&#xA;FROM BMLakewood_Source.dbo.Civil_Receipts CR WITH (NOLOCK) " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tbTransaction"
