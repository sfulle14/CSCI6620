      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblTransactionDetail&#xA;           ([TransactionID]&#xA;           ,[FeeID]&#xA;           ,[CaseID]&#xA;           ,[CaseFeeID]&#xA;           ,[Quantity]&#xA;           ,[FeeBaseAmount]&#xA;           ,[TotalFee]&#xA;           ,[PreviousPaid]&#xA;           ,[AmountOutstanding]&#xA;           ,[InterestDue]&#xA;           ,[AmountPaid]&#xA;           ,[Balance]&#xA;           ,[EntryType]&#xA;           ,[AllocationAmount]&#xA;           ,[WaivedRelatedFees]&#xA;           ,[Comment]&#xA;           ,[VoidDate]&#xA;           ,[VoidByUserID]&#xA;           ,[CaseBondID]&#xA;           ,[CaseFeeDeleted]&#xA;           ,[EscrowAccountID]&#xA;           ,[RemovedFromReceiptDate]&#xA;           ,[RemovedFromReceiptPartyID]&#xA;           ,[DoNotModify]&#xA;           ,[CreateByUserID]&#xA;           ,[CreateDate]&#xA;           ,[ModifyByUserID]&#xA;           ,[ModifyDate]&#xA;           ,[CaseHoldingAccountID]&#xA;           ,[TransactionPaymentID]&#xA;           ,[SplitFromTransactionDetailID])&#xA;SELECT&#xA;            NULL AS [TransactionID]&#xA;           ,NULL AS [FeeID]&#xA;           ,NULL AS [CaseID]&#xA;           ,NULL AS [CaseFeeID]&#xA;           ,NULL AS [Quantity]&#xA;           ,NULL AS [FeeBaseAmount]&#xA;           ,NULL AS [TotalFee]&#xA;           ,NULL AS [PreviousPaid]&#xA;           ,NULL AS [AmountOutstanding]&#xA;           ,NULL AS [InterestDue]&#xA;           ,NULL AS [AmountPaid]&#xA;           ,NULL AS [Balance]&#xA;           ,NULL AS [EntryType]&#xA;           ,NULL AS [AllocationAmount]&#xA;           ,NULL AS [WaivedRelatedFees]&#xA;           ,NULL AS [Comment]&#xA;           ,NULL AS [VoidDate]&#xA;           ,NULL AS [VoidByUserID]&#xA;           ,NULL AS [CaseBondID]&#xA;           ,NULL AS [CaseFeeDeleted]&#xA;           ,NULL AS [EscrowAccountID]&#xA;           ,NULL AS [RemovedFromReceiptDate]&#xA;           ,NULL AS [RemovedFromReceiptPartyID]&#xA;           ,NULL AS [DoNotModify]&#xA;           ,NULL AS [CreateByUserID]&#xA;           ,NULL AS [CreateDate]&#xA;           ,NULL AS [ModifyByUserID]&#xA;           ,NULL AS [ModifyDate]&#xA;           ,NULL AS [CaseHoldingAccountID]&#xA;           ,NULL AS [TransactionPaymentID]&#xA;           ,NULL AS [SplitFromTransactionDetailID]&#xA;FROM BMLakewood_Source.dbo." xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
