    <DTS:Executable
      DTS:refId="Package\tblFee"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{880F0140-5077-4B1A-8986-69CE83EDC34C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblFee"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblFee&#xA;&#x9;(FeeCode&#xA;&#x9;,FeeType&#xA;&#x9;,FeeShortDescription&#xA;&#x9;,FeeLongDescription&#xA;&#x9;,FeeBaseAmount&#xA;&#x9;,AllowMultiple&#xA;&#x9;,AllowFeeBaseOverride&#xA;&#x9;,AutoAssess&#xA;&#x9;,Active&#xA;&#x9;,HideOnReceipt&#xA;&#x9;,ComplianceType&#xA;&#x9;,FeePaymentPriority&#xA;&#x9;,AllowPaymentPriorToDisposition&#xA;&#x9;,AddBasedOnEffectiveDates&#xA;&#x9;,EffectiveDateCompareField&#xA;&#x9;,DefaultEffectiveDate&#xA;&#x9;,ICPEnabled&#xA;&#x9;,CCOCCourtTypeID&#xA;&#x9;,DisplayOrder&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;&#x9;,ExcludeFromBCCS&#xA;&#x9;,LastStatuteUpdateDate&#xA;&#x9;,CCOCMandatoryCode&#xA;&#x9;,FeeCategory)&#xA;SELECT&#xA;&#x9;C.Cost  AS FeeCode&#xA;&#x9;,NULL AS FeeType&#xA;&#x9;,C.Cost AS FeeShortDescription&#xA;&#x9;,C.Cost  AS FeeLongDescription&#xA;&#x9;,0 AS FeeBaseAmount&#xA;&#x9;,1 AS AllowMultiple&#xA;&#x9;,1 AS AllowFeeBaseOverride&#xA;&#x9;,1 AS AutoAssess&#xA;&#x9;,1 AS Active&#xA;&#x9;,0 AS HideOnReceipt&#xA;&#x9;,'' AS ComplianceType&#xA;&#x9;,C.Priority AS FeePaymentPriority&#xA;&#x9;,1 AS AllowPaymentPriorToDisposition&#xA;&#x9;,1 AS AddBasedOnEffectiveDates&#xA;&#x9;,'Today' AS EffectiveDateCompareField&#xA;&#x9;,NULL AS DefaultEffectiveDate&#xA;&#x9;,1 AS ICPEnabled&#xA;&#x9;,NULL AS CCOCCourtTypeID&#xA;&#x9;,NULL AS DisplayOrder&#xA;&#x9;,1 AS CreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;&#x9;,0 AS ExcludeFromBCCS&#xA;&#x9;,NULL AS LastStatuteUpdateDate&#xA;&#x9;,NULL AS CCOCMandatoryCode&#xA;&#x9;,'CRTR' AS FeeCategory&#xA;FROM BMLakewood_Source.dbo.Costs C WITH (NOLOCK)&#xA;WHERE C.Cost NOT IN (SELECT F.FeeCode FROM tblFee F)&#xA;&#xA;&#xA;INSERT INTO tblFee&#xA;&#x9;(FeeCode&#xA;&#x9;,FeeType&#xA;&#x9;,FeeShortDescription&#xA;&#x9;,FeeLongDescription&#xA;&#x9;,FeeBaseAmount&#xA;&#x9;,AllowMultiple&#xA;&#x9;,AllowFeeBaseOverride&#xA;&#x9;,AutoAssess&#xA;&#x9;,Active&#xA;&#x9;,HideOnReceipt&#xA;&#x9;,ComplianceType&#xA;&#x9;,FeePaymentPriority&#xA;&#x9;,AllowPaymentPriorToDisposition&#xA;&#x9;,AddBasedOnEffectiveDates&#xA;&#x9;,EffectiveDateCompareField&#xA;&#x9;,DefaultEffectiveDate&#xA;&#x9;,ICPEnabled&#xA;&#x9;,CCOCCourtTypeID&#xA;&#x9;,DisplayOrder&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;&#x9;,ExcludeFromBCCS&#xA;&#x9;,LastStatuteUpdateDate&#xA;&#x9;,CCOCMandatoryCode&#xA;&#x9;,FeeCategory)&#xA;SELECT&#xA;&#x9;CC.Cost  AS FeeCode&#xA;&#x9;,NULL AS FeeType&#xA;&#x9;,CC.Cost AS FeeShortDescription&#xA;&#x9;,CC.Cost  AS FeeLongDescription&#xA;&#x9;,0 AS FeeBaseAmount&#xA;&#x9;,1 AS AllowMultiple&#xA;&#x9;,1 AS AllowFeeBaseOverride&#xA;&#x9;,1 AS AutoAssess&#xA;&#x9;,1 AS Active&#xA;&#x9;,0 AS HideOnReceipt&#xA;&#x9;,'' AS ComplianceType&#xA;&#x9;,NULL AS FeePaymentPriority&#xA;&#x9;,1 AS AllowPaymentPriorToDisposition&#xA;&#x9;,1 AS AddBasedOnEffectiveDates&#xA;&#x9;,'Today' AS EffectiveDateCompareField&#xA;&#x9;,NULL AS DefaultEffectiveDate&#xA;&#x9;,1 AS ICPEnabled&#xA;&#x9;,NULL AS CCOCCourtTypeID&#xA;&#x9;,NULL AS DisplayOrder&#xA;&#x9;,1 AS CreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;&#x9;,0 AS ExcludeFromBCCS&#xA;&#x9;,NULL AS LastStatuteUpdateDate&#xA;&#x9;,NULL AS CCOCMandatoryCode&#xA;&#x9;,'CIVIL' AS FeeCategory&#xA;FROM BMLakewood_Source.dbo.Civil_Costs CC WITH (NOLOCK)&#xA;WHERE CC.Cost NOT IN (SELECT F.FeeCode FROM tblFee F)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblFeeDisbursement"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{3892BC76-EE60-4267-AB27-403E6B535A13}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblFeeDisbursement"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblFeeDisbursement&#xA;&#x9;(DisbursementCode&#xA;&#x9;,FeeID&#xA;&#x9;,FeeBasedOn&#xA;&#x9;,FeeBaseAmount&#xA;&#x9;,CountAtFeeBaseAmount&#xA;&#x9;,FeeAdditionalAmount&#xA;&#x9;,FeePercentage&#xA;&#x9;,FeeCalculationType&#xA;&#x9;,FeeDisbursementType&#xA;&#x9;,ArticleVFeeType&#xA;&#x9;,CustomFeeCalculation&#xA;&#x9;,ProratedFeeBaseAmount&#xA;&#x9;,MasterGLID&#xA;&#x9;,TransferMasterGLID&#xA;&#x9;,DisbursementPriority&#xA;&#x9;,PaymentPriority&#xA;&#x9;,JurisdictionID&#xA;&#x9;,AgencyID&#xA;&#x9;,Active&#xA;&#x9;,StartEffectiveDate&#xA;&#x9;,EndEffectiveDate&#xA;&#x9;,FSReference&#xA;&#x9;,DisAllowLien&#xA;&#x9;,MandatoryDiscretionary&#xA;&#x9;,InterestTypeDisbursementID&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;&#x9;,FLACArticleV)&#xA;SELECT&#xA;&#x9;GL.GLCode AS DisbursementCode&#xA;&#x9;,F.FeeID AS FeeID&#xA;&#x9;,NULL AS FeeBasedOn&#xA;&#x9;,F.FeeBaseAmount AS FeeBaseAmount&#xA;&#x9;,NULL AS CountAtFeeBaseAmount&#xA;&#x9;,NULL AS FeeAdditionalAmount&#xA;&#x9;,NULL AS FeePercentage&#xA;&#x9;,0 AS FeeCalculationType&#xA;&#x9;,0 AS FeeDisbursementType&#xA;&#x9;,0 AS ArticleVFeeType&#xA;&#x9;,NULL AS CustomFeeCalculation&#xA;&#x9;,NULL AS ProratedFeeBaseAmount&#xA;&#x9;,GL.MasterGLID AS MasterGLID&#xA;&#x9;,NULL AS TransferMasterGLID&#xA;&#x9;,1 AS DisbursementPriority&#xA;&#x9;,1 AS PaymentPriority&#xA;&#x9;,NULL AS JurisdictionID&#xA;&#x9;,GL.AgencyID AS AgencyID&#xA;&#x9;,1 AS Active&#xA;&#x9;,NULL AS StartEffectiveDate&#xA;&#x9;,NULL AS EndEffectiveDate&#xA;&#x9;,NULL AS FSReference&#xA;&#x9;,0 AS DisAllowLien&#xA;&#x9;,NULL AS MandatoryDiscretionary&#xA;&#x9;,0 AS InterestTypeDisbursementID&#xA;&#x9;,1 ASCreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;&#x9;,0 AS FLACArticle&#xA;FROM tblMasterGL GL WITH (NOLOCK) &#xA;&#x9;INNER JOIN tblMasterAccount MA WITH (NOLOCK) ON MA.MasterAccountID = GL.MasterGLID&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Costs C WITH (NOLOCK) ON C.Account_Id = MA.AccountNumber&#xA;&#x9;INNER JOIN tblFee F WITH (NOLOCK) ON F.FeeCode = C.Cost&#xA;WHERE GL.GLCode NOT IN (SELECT FD.DisbursementCode FROM tblFeeDisbursement FD)&#xA;&#xA;&#xA;&#xA;INSERT INTO tblFeeDisbursement&#xA;&#x9;(DisbursementCode&#xA;&#x9;,FeeID&#xA;&#x9;,FeeBasedOn&#xA;&#x9;,FeeBaseAmount&#xA;&#x9;,CountAtFeeBaseAmount&#xA;&#x9;,FeeAdditionalAmount&#xA;&#x9;,FeePercentage&#xA;&#x9;,FeeCalculationType&#xA;&#x9;,FeeDisbursementType&#xA;&#x9;,ArticleVFeeType&#xA;&#x9;,CustomFeeCalculation&#xA;&#x9;,ProratedFeeBaseAmount&#xA;&#x9;,MasterGLID&#xA;&#x9;,TransferMasterGLID&#xA;&#x9;,DisbursementPriority&#xA;&#x9;,PaymentPriority&#xA;&#x9;,JurisdictionID&#xA;&#x9;,AgencyID&#xA;&#x9;,Active&#xA;&#x9;,StartEffectiveDate&#xA;&#x9;,EndEffectiveDate&#xA;&#x9;,FSReference&#xA;&#x9;,DisAllowLien&#xA;&#x9;,MandatoryDiscretionary&#xA;&#x9;,InterestTypeDisbursementID&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;&#x9;,FLACArticleV)&#xA;SELECT&#xA;&#x9;GL.GLCode AS DisbursementCode&#xA;&#x9;,F.FeeID AS FeeID&#xA;&#x9;,NULL AS FeeBasedOn&#xA;&#x9;,F.FeeBaseAmount AS FeeBaseAmount&#xA;&#x9;,NULL AS CountAtFeeBaseAmount&#xA;&#x9;,NULL AS FeeAdditionalAmount&#xA;&#x9;,NULL AS FeePercentage&#xA;&#x9;,0 AS FeeCalculationType&#xA;&#x9;,0 AS FeeDisbursementType&#xA;&#x9;,0 AS ArticleVFeeType&#xA;&#x9;,NULL AS CustomFeeCalculation&#xA;&#x9;,NULL AS ProratedFeeBaseAmount&#xA;&#x9;,GL.MasterGLID AS MasterGLID&#xA;&#x9;,NULL AS TransferMasterGLID&#xA;&#x9;,1 AS DisbursementPriority&#xA;&#x9;,1 AS PaymentPriority&#xA;&#x9;,NULL AS JurisdictionID&#xA;&#x9;,GL.AgencyID AS AgencyID&#xA;&#x9;,1 AS Active&#xA;&#x9;,NULL AS StartEffectiveDate&#xA;&#x9;,NULL AS EndEffectiveDate&#xA;&#x9;,NULL AS FSReference&#xA;&#x9;,0 AS DisAllowLien&#xA;&#x9;,NULL AS MandatoryDiscretionary&#xA;&#x9;,0 AS InterestTypeDisbursementID&#xA;&#x9;,1 ASCreateByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS CreateDate&#xA;&#x9;,1 AS ModifyByUserID&#xA;&#x9;,CURRENT_TIMESTAMP AS ModifyDate&#xA;&#x9;,0 AS FLACArticle&#xA;FROM tblMasterGL GL WITH (NOLOCK) &#xA;&#x9;INNER JOIN tblMasterAccount MA WITH (NOLOCK) ON MA.MasterAccountID = GL.MasterGLID&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Civil_Costs CC WITH (NOLOCK) ON CC.Account_Id = MA.AccountNumber&#xA;&#x9;INNER JOIN tblFee F WITH (NOLOCK) ON F.FeeCode = CC.Cost&#xA;WHERE GL.GLCode NOT IN (SELECT FD.DisbursementCode FROM tblFeeDisbursement FD)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblGLDetail"
