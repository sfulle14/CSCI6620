          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblCheckApproval&#xA;           (CheckID&#xA;           ,CheckAccountApprovalLevelID&#xA;           ,Status&#xA;           ,Comment&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate)&#xA;SELECT&#xA;           NULL AS CheckID&#xA;           ,NULL AS CheckAccountApprovalLevelID&#xA;           ,NULL AS Status&#xA;           ,NULL AS Comment&#xA;           ,NULL AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,NULL AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;FROM" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
