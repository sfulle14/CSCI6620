    <DTS:Executable
      DTS:refId="Package\tblCheckDetail"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{37574283-4326-4ad3-821c-b446ce7a8c08}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCheckDetail"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblCheckDetail&#xA;           (CheckID&#xA;           ,TransactionID&#xA;           ,CaseID&#xA;           ,BondID&#xA;           ,RestitutionDetailID&#xA;           ,OriginatingTransactionID&#xA;           ,CaseDocketID&#xA;           ,Valid&#xA;           ,PONumber&#xA;           ,InvoiceNumber&#xA;           ,InvoiceAmount&#xA;           ,NetAmount&#xA;           ,Description&#xA;           ,RefundReason&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,PermanentVendorID&#xA;           ,CaseHoldingAccountID&#xA;           ,SplitFromCheckDetailID)&#xA;SELECT&#xA;           C.CheckID AS CheckID&#xA;           ,NULL AS TransactionID&#xA;           ,BMC.CaseID AS CaseID&#xA;           ,NULL AS BondID&#xA;           ,ISNULL(RD.RestitutionDetailID, '') AS RestitutionDetailID&#xA;           ,NULL AS OriginatingTransactionID&#xA;           ,NULL AS CaseDocketID&#xA;           ,NULL AS Valid&#xA;           ,NULL AS PONumber&#xA;           ,NULL AS InvoiceNumber&#xA;           ,NULL AS InvoiceAmount&#xA;           ,NULL AS NetAmount&#xA;           ,ISNULL(CD.Comment,'') AS Description&#xA;           ,NULL AS RefundReason&#xA;           ,LWC.User_Id AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,LWC.User_Id AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS PermanentVendorID&#xA;           ,NULL AS CaseHoldingAccountID&#xA;           ,NULL AS SplitFromCheckDetailID&#xA;FROM tblCheck C WITH (NOLOCK)&#xA;INNER JOIN BMLakewood_Source.dbo.Checks LWC WITH (NOLOCK) ON LWC.Check_Number = C.CheckNumber&#xA;INNER JOIN BMLakewood_Source.dbo.Check_Details CD WITH (NOLOCK) ON LWC.Check_Id = CD.Check_Id&#xA;INNER JOIN tblCase BMC WITH (NOLOCK) ON BMC.CaseNumber = CD.Case_Number&#xA;LEFT OUTER JOIN tblCaseFee CF WITH (NOLOCK) ON CF.CaseID = BMC.CaseID&#xA;LEFT OUTER JOIN tblRestitutionDetail RD WITH (NOLOCK) ON RD.RestitutionDetailID =  CF.RestitutionDetailID&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
