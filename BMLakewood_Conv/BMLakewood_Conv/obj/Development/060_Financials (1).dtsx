      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;&#xA;INSERT INTO tblCheckDetailImage&#xA;           (CheckDetailID&#xA;           ,SourceTableName&#xA;           ,SourceTableID&#xA;           ,CreateDate&#xA;           ,CreateByUserID&#xA;           ,ModifyDate&#xA;           ,ModifyByUserID)&#xA;SELECT&#xA;           NULL AS CheckDetailID&#xA;           ,NULL AS SourceTableName&#xA;           ,NULL AS SourceTableID&#xA;           ,NULL AS CreateDate&#xA;           ,NULL AS CreateByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS ModifyByUserID&#xA;FROM" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TRUNCATE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{7586C17A-FE4D-4F47-8195-773F7BE658B2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="TRUNCATE"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;EXEC DropConstraints &#xA;'tblMasterFund,tblMasterAccount,tblMasterGL,tblFee,tblFeeDisbursement'&#xA;&#xA;TRUNCATE TABLE tblMasterFund&#xA;TRUNCATE TABLE tblMasterAccount&#xA;TRUNCATE TABLE tblMasterGL&#xA;TRUNCATE TABLE tblFee&#xA;TRUNCATE TABLE tblFeeDisbursement&#xA;&#xA;&#xA;EXEC READD&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TRUNCATE TABLES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{a5d44dc1-1d93-4686-ad1a-3149f822ace6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="TRUNCATE TABLES"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="EXEC DropConstraints 'tblCaseFee,tblCaseFeeWaive,tblCaseLien,tblCaseLienCaseFee,tblRestitution,tblRestitutionDetail,tblCaseFeeDisbursement,tblCaseFeeWaiveDisbursement, tblCheck, tblCheckAccount, tblCheckDetail, tblCheckDetailImage, tblCheckAccountApprovalLevel, tblCheckApproval, tblCheckDetailGLDetail, tblTransaction, tblTransactionDetail, tblTransactionDetailFeeDisbursement, tblGLDetail'&#xA;&#xA;&#xA;TRUNCATE TABLE tblCaseFee&#xA;TRUNCATE TABLE tblCaseFeeWaive&#xA;TRUNCATE TABLE tblCaseLien&#xA;TRUNCATE TABLE tblCaseLienCaseFee&#xA;TRUNCATE TABLE tblRestitution&#xA;TRUNCATE TABLE tblRestitutionDetail&#xA;TRUNCATE TABLE tblCaseFeeDisbursement&#xA;TRUNCATE TABLE tblCaseFeeWaiveDisbursement&#xA;&#xA;TRUNCATE TABLE tblCheck&#xA;TRUNCATE TABLE tblCheckAccount&#xA;TRUNCATE TABLE tblCheckDetail&#xA;TRUNCATE TABLE tblCheckDetailImage&#xA;TRUNCATE TABLE tblCheckAccountApprovalLevel&#xA;TRUNCATE TABLE tblCheckApproval&#xA;TRUNCATE TABLE tblCheckDetailGLDetail&#xA;TRUNCATE TABLE tblTransaction&#xA;TRUNCATE TABLE tblTransactionDetail&#xA;TRUNCATE TABLE tblTransactionDetailFeeDisbursement&#xA;TRUNCATE TABLE tblGLDetail&#xA;&#xA;&#xA;EXEC READD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\UPDATE tblCaseFee"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{ee19fad1-f899-4f8d-8f07-12d85204b88e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="UPDATE tblCaseFee"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="-- Update the Case Fee with the Fee data&#xA;UPDATE tblCaseFee&#xA;SET         &#xA;      FeeID = FD.FeeID&#xA;&#xA;  FROM tblCaseFee CF WITH (NOLOCK)&#xA;  JOIN tblCase C WITH (NOLOCK) ON C.CaseID = CF.CaseID&#xA;  JOIN BMLakewood_Source.dbo.Civil_Receipts CR WITH (NOLOCK) ON CR.Civil_Case_Id = C.CaseID&#xA;  JOIN BMLakewood_Source.dbo.Civil_Receipt_Costs CRC WITH (NOLOCK) ON CRC.Civil_Receipt_Number = CR.Civil_Receipt_Number&#xA;  JOIN BMLakewood_Source.dbo.Civil_Costs CC WITH (NOLOCK) ON CC.Civil_Cost_Id = CRC.Civil_Cost_Id&#xA;  JOIN tblFeeDisbursement FD WITH (NOLOCK) ON FD.DisbursementCode = CC.Cost&#xA;&#xA;-- Update Case Fee with the Waive data&#xA;UPDATE tblCaseFee&#xA;SET&#xA;&#x9;WaivedReason = CFW.WaiveReasonID&#xA;&#x9;,WaivedAmount = CFW.WaiveAmount&#xA;&#x9;,WaivedAmount_Article5 = 0&#xA;FROM tblCaseFee CF WITH (NOLOCK) &#xA;&#x9;JOIN tblCaseFeeWaive CFW WITH (NOLOCK) ON CFW.CaseFeeID = CF.CaseFeeID&#xA;&#xA;&#xA;--Update with Lien data&#xA;&#xA;UPDATE tblCaseFee&#xA;SET&#xA;&#x9;LienDate = CL.LienDate&#xA;&#x9;,LienAmount = CL.LienAmount&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA;&#x9;JOIN tblCaseLien CL WITH (NOLOCK) ON CL.CaseID = CF.CaseID&#xA;&#xA;&#xA;--Update with the amount paid data&#xA;&#xA;UPDATE tblCaseFee&#xA;SET&#xA;&#x9;AmountPaid = ISNULL(FCR.Amount_Paid, 0.00)&#xA;&#x9;,AmountOutstanding = ISNULL((CF.TotalFee - FCR.Amount_Paid),0.00)&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA;&#x9;JOIN tblCase C WITH (NOLOCK) ON C.CaseID = CF.CaseID&#xA;&#x9;JOIN BMLakewood_Source.dbo.Case_Violations CV WITH (NOLOCK) ON CV.Case_Number = C.CaseNumber&#xA;&#x9;JOIN BMLakewood_Source.dbo.Fine_Costs_Receipts FCR WITH (NOLOCK) ON FCR.Case_Violation_Id = CV.Case_Violation_Id&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\UPDATE tblCaseFee_Restitution"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{9b592a67-3935-4e3c-bd3f-3682bce0d772}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="UPDATE tblCaseFee_Restitution"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="--Update Restitution data&#xA;&#xA;UPDATE tblCaseFee&#xA;SET&#xA; RestitutionTotalFee = AC.Original_Amount&#xA; ,RestitutionAmountPaid = AC.Amount_Paid&#xA; ,RestitutionAmountOutstanding = (AC.Original_Amount - AC.Amount_Paid)&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA; JOIN tblCase C WITH (NOLOCK) ON C.CaseID = CF.CaseID&#xA; LEFT JOIN BMLakewood_Source.dbo.Case_Violations CV WITH (NOLOCK) ON CV.Case_Number = C.CaseNumber&#xA; LEFT JOIN BMLakewood_Source.dbo.Amount_Costs AC WITH (NOLOCK) ON AC.Case_Violation_Id = CV.Case_Violation_Id&#xA;WHERE C.CaseNumber = CV.Case_Number&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
