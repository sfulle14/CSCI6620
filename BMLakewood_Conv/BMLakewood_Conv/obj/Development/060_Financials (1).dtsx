      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblTransaction&#xA;           (AgentID&#xA;           ,EscrowAccountID&#xA;           ,TransactionName&#xA;           ,Address1&#xA;           ,Address2&#xA;           ,City&#xA;           ,State&#xA;           ,Zip&#xA;           ,Phone&#xA;           ,OBOCasePartyID&#xA;           ,RefundAmount&#xA;           ,ReceiptNumber&#xA;           ,Password&#xA;           ,PaymentPlanID&#xA;           ,CashierByUserID&#xA;           ,CashierDate&#xA;           ,VoidByUserID&#xA;           ,VoidDate&#xA;           ,Status&#xA;           ,PaymentLocation&#xA;           ,RefundReason&#xA;           ,Comment&#xA;           ,ReversedByTransactionID&#xA;           ,ReverseOfTransactionID&#xA;           ,LockDate&#xA;           ,LockByUserID&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,SplitFromTransactionID)&#xA;SELECT&#xA;            NULL AS AgentID&#xA;           ,NULL AS EscrowAccountID&#xA;           ,NULL AS TransactionName&#xA;           ,NULL AS Address1&#xA;           ,NULL AS Address2&#xA;           ,NULL AS City&#xA;           ,NULL AS State&#xA;           ,NULL AS Zip&#xA;           ,NULL AS Phone&#xA;           ,NULL AS OBOCasePartyID&#xA;           ,NULL AS RefundAmount&#xA;           ,NULL AS ReceiptNumber&#xA;           ,NULL AS Password&#xA;           ,NULL AS PaymentPlanID&#xA;           ,NULL AS CashierByUserID&#xA;           ,NULL AS CashierDate&#xA;           ,NULL AS VoidByUserID&#xA;           ,NULL AS VoidDate&#xA;           ,NULL AS Status&#xA;           ,NULL AS PaymentLocation&#xA;           ,NULL AS RefundReason&#xA;           ,NULL AS Comment&#xA;           ,NULL AS ReversedByTransactionID&#xA;           ,NULL AS ReverseOfTransactionID&#xA;           ,NULL AS LockDate&#xA;           ,NULL AS LockByUserID&#xA;           ,NULL AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,NULL AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS SplitFromTransactionID&#xA;&#xA;FROM BMLakewood_Source.dbo." xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tlCheckDetailImage"
