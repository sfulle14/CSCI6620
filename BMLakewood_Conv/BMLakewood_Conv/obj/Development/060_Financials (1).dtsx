          SQLTask:SqlStatementSource="INSERT INTO TMPFEEDISBURSEMENT&#xA; (DisbursementCode&#xA; ,FeeID&#xA; ,FeeBasedOn&#xA; ,FeeBaseAmount&#xA; ,CountAtFeeBaseAmount&#xA; ,FeeAdditionalAmount&#xA; ,FeePercentage&#xA; ,FeeCalculationType&#xA; ,FeeDisbursementType&#xA; ,ArticleVFeeType&#xA; ,CustomFeeCalculation&#xA; ,ProratedFeeBaseAmount&#xA; ,MasterGLID&#xA; ,TransferMasterGLID&#xA; ,DisbursementPriority&#xA; ,PaymentPriority&#xA; ,JurisdictionID&#xA; ,AgencyID&#xA; ,Active&#xA; ,StartEffectiveDate&#xA; ,EndEffectiveDate&#xA; ,FSReference&#xA; ,DisAllowLien&#xA; ,MandatoryDiscretionary&#xA; ,InterestTypeDisbursementID&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,FLACArticleV)&#xA;SELECT&#xA; DisbursementCode&#xA; ,FeeID&#xA; ,FeeBasedOn&#xA; ,FeeBaseAmount&#xA; ,CountAtFeeBaseAmount&#xA; ,FeeAdditionalAmount&#xA; ,FeePercentage&#xA; ,FeeCalculationType&#xA; ,FeeDisbursementType&#xA; ,ArticleVFeeType&#xA; ,CustomFeeCalculation&#xA; ,ProratedFeeBaseAmount&#xA; ,MasterGLID&#xA; ,TransferMasterGLID&#xA; ,DisbursementPriority&#xA; ,PaymentPriority&#xA; ,JurisdictionID&#xA; ,AgencyID&#xA; ,Active&#xA; ,StartEffectiveDate&#xA; ,EndEffectiveDate&#xA; ,FSReference&#xA; ,DisAllowLien&#xA; ,MandatoryDiscretionary&#xA; ,InterestTypeDisbursementID&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,FLACArticleV&#xA;FROM tblFeeDisbursement WITH (NOLOCK) &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\INSERT PRESERVE FUND"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{262a3514-5adc-49aa-8731-14c09fb73d92}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT PRESERVE FUND"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO TMPMASTERFUND&#x9;&#xA;&#x9;(BankID&#x9;&#xA;&#x9;,FundNumber&#xA;&#x9;,FundDescription&#xA;&#x9;,CreateByUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate)&#xA;SELECT&#xA;&#x9;BankID&#xA;&#x9;,FundNumber&#xA;&#x9;,FundDescription&#xA;&#x9;,CreateBYUserID&#xA;&#x9;,CreateDate&#xA;&#x9;,ModifyByUserID&#xA;&#x9;,ModifyDate&#xA;FROM tblMasterFund WITH (NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\INSERT PRESERVE GL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{1831d82c-a3ad-4421-85fc-04a92a72bf1c}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT PRESERVE GL"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO TMPMASTERGL&#xA; (GLCode&#xA; ,MasterFundID&#xA; ,MasterAccountID&#xA; ,OffsetMasterGLID&#xA; ,MergeToMasterGLID&#xA; ,GLDescription&#xA; ,Active&#xA; ,PayeeName&#xA; ,DORSection&#xA; ,DORLineItem&#xA; ,ArticleVFeeType&#xA; ,MandatoryDiscretionary&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,PaymentPriority&#xA; ,DORLineCode&#xA; ,AgencyID&#xA; ,CheckAccountID&#xA; ,HoldingAccount&#xA; ,AgencyYearlyPayAmount&#xA; ,PayAmountExceededAgencyID&#xA; ,AgencyCheckStartDate)&#xA;SELECT&#xA; GLCode&#xA; ,MasterFundID&#xA; ,MasterAccountID&#xA; ,OffsetMasterGLID&#xA; ,MergeToMasterGLID&#xA; ,GLDescription&#xA; ,Active&#xA; ,PayeeName&#xA; ,DORSection&#xA; ,DORLineItem&#xA; ,ArticleVFeeType&#xA; ,MandatoryDiscretionary&#xA; ,CreateByUserID&#xA; ,CreateDate&#xA; ,ModifyByUserID&#xA; ,ModifyDate&#xA; ,PaymentPriority&#xA; ,DORLineCode&#xA; ,AgencyID&#xA; ,CheckAccountID&#xA; ,HoldingAccount&#xA; ,AgencyYearlyPayAmount&#xA; ,PayAmountExceededAgencyID&#xA; ,AgencyCheckStartDate&#xA;FROM tblMasterGL WITH (NOLOCK)&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCaseFee"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{850d9a14-d017-47ab-b8b5-30223f8e58e4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCaseFee"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;--Civil_Receipts&#xA;INSERT INTO tblCaseFee&#xA;           (CaseID&#xA;           ,CaseChargeID&#xA;           ,SentenceID&#xA;           ,FeeID&#xA;           ,TotalFee&#xA;           ,BaseFineAmount&#xA;           ,FineReduced&#xA;           ,AmountPaid&#xA;           ,AmountOutstanding&#xA;           ,Assessed&#xA;           ,EffectiveDate&#xA;           ,DueDate&#xA;           ,LienDate&#xA;           ,LienPercentage&#xA;           ,LienAmount&#xA;           ,RestitutionID&#xA;           ,RestitutionDetailID&#xA;           ,RestitutionPaymentPriority&#xA;           ,RestitutionTotalFee&#xA;           ,RestitutionAmountPaid&#xA;           ,RestitutionAmountOutstanding&#xA;           ,WaivedReason&#xA;           ,WaivedAmount&#xA;           ,WaivedAmount_Article5&#xA;           ,PaymentPlanID&#xA;           ,InterestType&#xA;           ,InterestRate&#xA;           ,InterestAccrued&#xA;           ,InterestPaid&#xA;           ,InterestAccruedDate&#xA;           ,ParentCaseFeeID&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,ConditionOfProbation&#xA;           ,DisplayPayeePartyID&#xA;           ,CheckPayeePartyID&#xA;           ,SourceTableName&#xA;           ,SourceTableID)&#xA;SELECT --CaseFeeID&#xA;      C.CaseID AS CaseID &#xA;      ,NULL AS CaseChargeID&#xA;      ,NULL AS SentenceID&#xA;      ,F.FeeID AS FeeID&#xA;      ,ISNULL(CR.Amount_Paid,0.00) AS TotalFee&#xA;      ,CASE WHEN CR.Amount_Paid IS NULL THEN 0.00 &#xA;&#x9;&#x9;&#x9;WHEN CR.Amount_Paid = 0.00 THEN 0.00&#xA;&#x9;&#x9;&#x9;ELSE TRY_CONVERT(money,CR.Amount_Paid)&#xA;&#x9;&#x9;END AS BaseFineAmount&#xA;      ,0.00 AS FineReduced&#xA;      ,CR.Amount_Paid AS AmountPaid&#xA;      ,0.00 AS AmountOutstanding&#xA;      ,1 AS Assessed&#xA;      ,CR.Date_Receipted AS EffectiveDate&#xA;      ,NULL AS DueDate&#xA;      ,NULL AS LienDate&#xA;      ,0 AS LienPercentage&#xA;      ,0 AS LienAmount&#xA;      ,NULL AS RestitutionID&#xA;      ,NULL AS RestitutionDetailID&#xA;      ,NULL AS RestitutionPaymentPriority&#xA;      ,0 AS RestitutionTotalFee&#xA;      ,0 AS RestitutionAmountPaid&#xA;      ,0 AS RestitutionAmountOutstanding&#xA;      ,NULL AS WaivedReason&#xA;      ,0 AS WaivedAmount&#xA;      ,0 AS WaivedAmount_Article5&#xA;      ,NULL AS PaymentPlanID&#xA;      ,NULL AS InterestType&#xA;      ,0 AS InterestRate&#xA;      ,0 AS InterestAccrued&#xA;      ,0 AS InterestPaid&#xA;      ,NULL AS InterestAccruedDate&#xA;      ,NULL AS ParentCaseFeeID&#xA;      ,C.CreateByUserID AS CreateByUserID&#xA;      ,CR.Date_Receipted AS CreateDate&#xA;      ,C.ModifyByUserID AS ModifyByUserID&#xA;      ,CR.Date_Receipted AS ModifyDate&#xA;      ,NULL AS ConditionOfProbation&#xA;      ,NULL AS DisplayPayeePartyID&#xA;      ,NULL AS CheckPayeePartyID&#xA;      ,'Civil_Receipts' AS SourceTableName&#xA;      ,CR.Civil_Receipt_Number AS SourceTableID&#xA;  FROM BMLakewood_Source.dbo.Civil_Receipts CR&#xA;&#x9;INNER JOIN tblCase C WITH (NOLOCK) ON C.CaseID = CR.Civil_Case_Id&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Civil_Receipt_Types CRT WITH (NOLOCK) ON CRT.Type_Id = CR.Type_Id&#xA;&#x9;INNER JOIN tblFee F WITH (NOLOCK) ON F.FeeCode = CRT.Type  AND F.FeeCategory = 'CIVIL' --F.CCOCMandatoryCode = CR.Type_Id &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCaseFeeDisbursment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1e9744ae-8c46-4337-b376-294a161e25b0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCaseFeeDisbursment"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="--Civil_Receipt_Costs&#xA;INSERT INTO tblCaseFeeDisbursement&#xA;           (CaseFeeID&#xA;           ,FeeDisbursementID&#xA;           ,MasterGLID&#xA;           ,CalculatedAmount&#xA;           ,DisburseAmount&#xA;           ,AmountPaid&#xA;           ,AmountOutstanding&#xA;           ,Waived&#xA;           ,WaivedReason&#xA;           ,WaivedByID&#xA;           ,WaivedDate&#xA;           ,WaivedAmount&#xA;           ,WaiveAmount_Article5&#xA;           ,LienAmount&#xA;           ,DisbursementPriority&#xA;           ,PaymentPriority&#xA;           ,FeeDisbursementType&#xA;           ,FeeCalculationType&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,InactivePerStatuteFeeChange)&#xA;SELECT &#xA;           CF.CaseFeeID AS CaseFeeID&#xA;           ,FD.FeeDisbursementID AS FeeDisbursementID&#xA;           ,GL.MasterGLID AS MasterGLID&#xA;           ,CRC.Amount_Paid AS CalculatedAmount&#xA;           ,CRC.Amount_Paid AS DisburseAmount&#xA;           ,CRC.Amount_Paid AS AmountPaid&#xA;           ,0.00 AS AmountOutstanding&#xA;           ,0 AS Waived&#xA;           ,NULL AS WaivedReason&#xA;           ,NULL AS WaivedByID&#xA;           ,NULL AS WaivedDate&#xA;           ,0.00 AS WaivedAmount&#xA;           ,0.00 AS WaiveAmount_Article5&#xA;           ,0.00 AS LienAmount&#xA;           ,NULL AS DisbursementPriority&#xA;           ,NULL AS PaymentPriority&#xA;           ,NULL AS FeeDisbursementType&#xA;           ,NULL AS FeeCalculationType&#xA;           ,CF.CreateByUserID AS CreateByUserID&#xA;           ,CF.CreateDate AS CreateDate&#xA;           ,CF.ModifyByUserID AS ModifyByUserID&#xA;           ,CF.ModifyDate AS ModifyDate&#xA;           ,NULL AS InactivePerStatuteFeeChange&#xA;FROM tblCaseFee CF WITH (NOLOCK)&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Civil_Receipts CR WITH (NOLOCK) ON CR.Civil_Receipt_Number = CF.SourceTableID&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Civil_Receipt_Costs CRC WITH (NOLOCK) ON CR.Civil_Receipt_Number = CRC.Civil_Receipt_Number&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Civil_Costs CC WITH (NOLOCK) ON CC.Civil_Cost_Id = CRC.Civil_Cost_Id&#xA;&#x9;INNER JOIN tblFeeDisbursement FD WITH (NOLOCK) ON FD.FeeID = CF.FeeID and LTRIM(RTRIM(FD.DisbursementCode)) LIKE LTRIM(RTRIM(CC.Cost)) &#xA;&#x9;LEFT OUTER JOIN tblMasterGL GL WITH (NOLOCK) ON GL.MasterGLID = FD.MasterGLID &#xA;WHERE CRC.Amount_Paid &gt; 0.00" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCaseFeeWaive"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{2a2e06d2-59c5-4b75-81cd-a2564bcc519e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCaseFeeWaive"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblCaseFeeWaive&#xA;           (CaseFeeID&#xA;           ,WaiveReasonID&#xA;           ,WaiveAmount&#xA;           ,WaiveAmount_Article5&#xA;           ,WaiveDate&#xA;           ,WaiveByPartyID&#xA;           ,UnWaiveDate&#xA;           ,UnWaiveByPartyID&#xA;           ,WaiveInterest&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate)&#xA;SELECT&#xA;           CF.CaseFeeID AS CaseFeeID&#xA;           ,(SELECT WaiveReasonID FROM tblWaiveReason WS WITH (NOLOCK) where WS.Description = 'Community Service') AS WaiveReasonID&#xA;           ,AC.CS_Credit AS WaiveAmount&#xA;           ,NULL AS WaiveAmount_Article5&#xA;           --,CSD.Date_Performed AS WaiveDate&#xA;           ,NULL AS WaiveDate&#xA;           ,NULL AS WaiveByPartyID&#xA;           ,NULL AS UnWaiveDate&#xA;           ,NULL AS UnWaiveByPartyID&#xA;           ,1 AS WaiveInterest&#xA;           ,C.CreateByUserID AS CreateByUserID&#xA;           ,C.CreateDate AS CreateDate&#xA;           ,C.ModifyByUserID AS ModifyByUserID&#xA;           ,C.ModifyDate AS ModifyDate&#xA;&#xA;FROM BMLakewood_Source.dbo.Amount_Costs AC WITH (NOLOCK)&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Case_Violations CV WITH (NOLOCK) ON CV.Case_Violation_Id = AC.Case_Violation_Id&#xA;&#x9;INNER JOIN tblCase C WITH (NOLOCK) ON C.CaseNumber = CV.Case_Number&#xA;&#x9;LEFT OUTER JOIN tblCaseFee CF WITH (NOLOCK) ON CF.CaseID = C.CaseID&#xA;&#x9;JOIN BMLakewood_Source.dbo.Community_Services CS WITH (NOLOCK) ON CS.Case_Violation_Id = CV.Case_Violation_Id&#xA;&#x9;--JOIN BMLakewood_Source.dbo.Community_Service_Details CSD WITH (NOLOCK) ON CSD.Community_Service_Id = CS.Community_Service_Id&#xA;Where AC.CS_Credit &gt; 0.00&#xA;&#xA;UNION &#xA;&#xA;SELECT&#xA;           CF.CaseFeeID AS CaseFeeID&#xA;           ,(SELECT WaiveReasonID FROM tblWaiveReason WS WITH (NOLOCK) where WS.Description = 'Suspended') AS WaiveReasonID&#xA;           ,AC.Suspended_Amount AS WaiveAmount&#xA;           ,NULL AS WaiveAmount_Article5&#xA;           ,NULL AS WaiveDate&#xA;           ,NULL AS WaiveByPartyID&#xA;           ,NULL AS UnWaiveDate&#xA;           ,NULL AS UnWaiveByPartyID&#xA;           ,1 AS WaiveInterest&#xA;           ,C.CreateByUserID AS CreateByUserID&#xA;           ,C.CreateDate AS CreateDate&#xA;           ,C.ModifyByUserID AS ModifyByUserID&#xA;           ,C.ModifyDate AS ModifyDate&#xA;FROM BMLakewood_Source.dbo.Amount_Costs AC WITH (NOLOCK)&#xA;&#x9;INNER JOIN BMLakewood_Source.dbo.Case_Violations CV WITH (NOLOCK) ON CV.Case_Violation_Id = AC.Case_Violation_Id&#xA;&#x9;INNER JOIN tblCase C WITH (NOLOCK) ON C.CaseNumber = CV.Case_Number&#xA;&#x9;LEFT OUTER JOIN tblCaseFee CF WITH (NOLOCK) ON CF.CaseID = C.CaseID&#xA;WHERE AC.Suspended_Amount &gt; 0.00" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCaseFeeWaiveDisbursement"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{ed016766-b2e1-4049-86e0-0b60abea3826}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCaseFeeWaiveDisbursement"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="INSERT INTO tblCaseFeeWaiveDisbursement&#xA;           (CaseFeeWaiveID&#xA;           ,CaseFeeDisbursementID&#xA;           ,AmountWaived&#xA;           ,AmountWaived_Article5&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate)&#xA;SELECT&#x9;--CaseFeeWaiveDisbursementID&#xA;           CFW.CaseFeeWaiveID AS CaseFeeWaiveID&#xA;           ,CFD.CaseFeeDisbursementID AS CaseFeeDisbursementID&#xA;           ,CFW.WaiveAmount AS AmountWaived&#xA;           ,CFW.WaiveAmount_Article5 AS AmountWaived_Article5&#xA;           ,CFW.CreateByUserID AS CreateByUserID&#xA;           ,CFW.CreateDate AS CreateDate&#xA;           ,CFW.ModifyByUserID AS ModifyByUserID&#xA;           ,CFW.ModifyDate AS ModifyDate&#xA;FROM tblCaseFeeWaive CFW WITH (NOLOCK) &#xA;&#x9;JOIN tblCaseFeeDisbursement CFD WITH (NOLOCK) ON CFD.CaseFeeID = CFW.CaseFeeID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCheck"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{e179df39-1da6-4b6c-aaa1-6df8c0e6b6a6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCheck"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblCheck&#xA;           (CheckNumber&#xA;           ,CheckDate&#xA;           ,PartyID&#xA;           ,CheckName&#xA;           ,Address1&#xA;           ,Address2&#xA;           ,City&#xA;           ,State&#xA;           ,Zip&#xA;           ,CheckAmount&#xA;           ,CheckAccountID&#xA;           ,DisburseImmediately&#xA;           ,VoidByUserID&#xA;           ,VoidDate&#xA;           ,VoidTransactionID&#xA;           ,ReIssueCheckID&#xA;           ,CombineToCheckID&#xA;           ,ReconcileAmount&#xA;           ,ReconcilePayDate&#xA;           ,ReconcileDate&#xA;           ,PrintApproval&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,ModifyReason&#xA;           ,DisapproveReason&#xA;           ,Exported&#xA;           ,NativeCheckNumber&#xA;           ,SplitFromCheckID)&#xA; SELECT&#xA;            LWC.Check_Number AS CheckNumber&#xA;           ,LWC.Date_on_Check AS CheckDate&#xA;           ,NULL AS PartyID&#xA;           ,LWC.Pay_To AS CheckName&#xA;           ,LWC.Pay_To_Address1 + ' ' + LWC.Pay_To_Address2 AS Address1&#xA;           ,LWC.Pay_To_Address3 AS Address2&#xA;           ,NULL AS City&#xA;           ,NULL AS State&#xA;           ,NULL AS Zip&#xA;           ,LWC.Amount AS CheckAmount&#xA;           ,NULL AS CheckAccountID&#xA;           ,NULL AS DisburseImmediately&#xA;           ,CV.User_Id AS VoidByUserID&#xA;           ,CV.Date_on_Check AS VoidDate&#xA;           ,NULL AS VoidTransactionID&#xA;           ,NULL AS ReIssueCheckID&#xA;           ,NULL AS CombineToCheckID&#xA;           ,NULL AS ReconcileAmount&#xA;           ,NULL AS ReconcilePayDate&#xA;           ,LWC.Date_Reconciled AS ReconcileDate&#xA;           ,NULL AS PrintApproval&#xA;           ,LWC.User_Id AS CreateByUserID&#xA;           ,CURRENT_TIMESTAMP AS CreateDate&#xA;           ,LWC.User_Id AS ModifyByUserID&#xA;           ,CURRENT_TIMESTAMP AS ModifyDate&#xA;           ,NULL AS ModifyReason&#xA;           ,NULL AS DisapproveReason&#xA;           ,NULL AS Exported&#xA;           ,NULL AS NativeCheckNumber&#xA;           ,NULL AS SplitFromCheckID&#xA;FROM BMLakewood_Source.dbo.Checks LWC WITH (NOLOCK)&#xA;LEFT OUTER JOIN BMLakewood_Source.dbo.Checks_Void CV WITH (NOLOCK) ON CV.Check_Id = LWC.Check_Id&#xA;&#xA;/*&#xA;Cannot parse city, state, zip out of source Pay_To_Address3 because &#xA;the data is not consistant.&#xA;&#x9;*Not every city has a comma after it.&#xA;&#x9;*Some states are abbreviated others spelled out&#xA;&#x9;*Different zip code lengths used&#xA;&#x9;*Some are just NULL&#xA;*/&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCheckAccount"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{b98bad60-2b86-4cad-87cc-730140b97b87}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCheckAccount"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblCheckAccount&#xA;           (BankID&#xA;           ,AccountName&#xA;           ,AccountNumber&#xA;           ,RoutingNumber&#xA;           ,ReconcileAccountNumber&#xA;           ,SequenceID&#xA;           ,MasterGLID&#xA;           ,ReportID&#xA;           ,RequirePrintApproval&#xA;           ,Active&#xA;           ,FeeID&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,RightName)&#xA;SELECT&#xA;           LWC.Bank_Account_Id AS BankID&#xA;           ,MA.AccountDescription AS AccountName&#xA;           ,MA.AccountNumber AS AccountNumber&#xA;           ,NULL AS RoutingNumber&#xA;           ,NULL AS ReconcileAccountNumber&#xA;           ,NULL AS SequenceID&#xA;           ,GL.MasterGLID AS MasterGLID&#xA;           ,NULL AS ReportID&#xA;           ,NULL AS RequirePrintApproval&#xA;           ,1 AS Active&#xA;           ,F.FeeID AS FeeID&#xA;           ,LWC.User_Id AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,LWC.User_Id AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS RightName&#xA;FROM BMLakewood_Source.dbo.Checks LWC WITH (NOLOCK)&#xA;INNER JOIN BMLakewood_Source.dbo.Check_Details CD WITH (NOLOCK) ON LWC.Check_Id = CD.Check_Id&#xA;INNER JOIN BMLakewood_Conv.dbo.tblCase C WITH (NOLOCK) ON C.CaseNumber = CD.Case_Number&#xA;INNER JOIN BMLakewood_Conv.dbo.tblCaseFee CF WITH (NOLOCK) ON CF.CaseID = C.CaseID&#xA;INNER JOIN BMLakewood_Conv.dbo.tblMasterFund MF WITH (NOLOCK) ON LWC.Bank_Account_Id = MF.MasterFundID&#xA;INNER JOIN BMLakewood_Conv.dbo.tblFee F WITH (NOLOCK) ON F.FeeID = CF.FeeID&#xA;INNER JOIN BMLakewood_Conv.dbo.tblMasterAccount MA WITH (NOLOCK) ON MA.AccountNumber = F.FeeCode&#xA;INNER JOIN BMLakewood_Conv.dbo.tblMasterGL GL WITH (NOLOCK) ON GL.MasterAccountID = MA.MasterAccountID&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\tblCheckAccountApprovalLevel"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{07258ca6-b467-467c-bc04-2b33b73f8409}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="tblCheckAccountApprovalLevel"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E4B2904E-8E62-48EF-9713-D1980A54B06F}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO tblCheckAccountApprovalLevel&#xA;           (CheckAccountID&#xA;           ,ApprovalLevelID&#xA;           ,MaxAmount&#xA;           ,ApprovalRank&#xA;           ,RightName&#xA;           ,CreateByUserID&#xA;           ,CreateDate&#xA;           ,ModifyByUserID&#xA;           ,ModifyDate&#xA;           ,RequireCourtApproval&#xA;           ,RequireFinanceApproval)&#xA;SELECT&#xA;           NULL AS CheckAccountID&#xA;           ,NULL AS ApprovalLevelID&#xA;           ,NULL AS MaxAmount&#xA;           ,NULL AS ApprovalRank&#xA;           ,NULL AS RightName&#xA;           ,NULL AS CreateByUserID&#xA;           ,NULL AS CreateDate&#xA;           ,NULL AS ModifyByUserID&#xA;           ,NULL AS ModifyDate&#xA;           ,NULL AS RequireCourtApproval&#xA;           ,NULL AS RequireFinanceApproval&#xA;FROM" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
