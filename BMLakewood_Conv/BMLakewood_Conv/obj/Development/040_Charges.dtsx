C.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE