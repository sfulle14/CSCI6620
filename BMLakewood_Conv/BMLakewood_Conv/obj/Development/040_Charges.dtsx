      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;EXEC DropConstraints 'tblCaseCharge,tblCaseProcessAction,tblCaseProcessActionCaseCharge,tblCitation,tblCaseBond,tblStatute'&#xA;&#xA;TRUNCATE TABLE tblCaseCharge&#xA;TRUNCATE TABLE tblCaseProcessActionCaseCharge&#xA;TRUNCATE TABLE tblCitation&#xA;TRUNCATE TABLE tblCaseBond&#xA;--TRUNCATE TABLE tblStatute&#xA;&#xA;EXEC READD&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\UPDATE tblStatute"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{2ea9b9dd-4ce0-4d6c-a8e9-2cfc0ab7c26e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="UPDATE tblStatute"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;UPDATE tblStatute&#xA;SET&#xA;&#x9;Active = 0&#xA;FROM BMLakewood_Source.dbo.Violation_Codes VC WITH (NOLOCK)&#xA;INNER JOIN tblStatute S WITH (NOLOCK) ON VC.Section_Number = S.StatuteNumber&#xA;WHERE VC.Date_Valid_To is not NULL&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\XREF_TRCR_Disposition"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4b71995f-8585-40fe-9274-776da47e0725}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="XREF_TRCR_Disposition"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--GBDI-918&#xA;IF NOT EXISTS(select * from information_SCHEMA.COLUMNS where TABLE_NAME='XREF_TRCR_Disposition' and COLUMN_NAME='OCC_Priviledges_Comments')&#xA;BEGIN&#xA;&#x9;ALTER TABLE XREF_TRCR_Disposition&#xA;&#x9;ADD OCC_Priviledges_Comments VARCHAR(max)&#xA;END&#xA;&#xA;--GBDI-849&#xA;IF NOT EXISTS(select * from information_SCHEMA.COLUMNS where TABLE_NAME='XREF_TRCR_Disposition' and COLUMN_NAME='MO_Narrative_Id')&#xA;BEGIN&#xA;&#x9;ALTER TABLE XREF_TRCR_Disposition&#xA;&#x9;ADD MO_Narrative_Id Int&#xA;END&#xA;&#xA;--GBDI-1063&#xA;IF NOT EXISTS(select * from information_SCHEMA.COLUMNS where TABLE_NAME='XREF_TRCR_Disposition' and COLUMN_NAME='Probation_From')&#xA;BEGIN&#xA;&#x9;ALTER TABLE XREF_TRCR_Disposition&#xA;&#x9;ADD Probation_From Date&#xA;END&#xA;--GBDI-1063&#xA;IF NOT EXISTS(select * from information_SCHEMA.COLUMNS where TABLE_NAME='XREF_TRCR_Disposition' and COLUMN_NAME='Probation_To')&#xA;BEGIN&#xA;&#x9;ALTER TABLE XREF_TRCR_Disposition&#xA;&#x9;ADD Probation_To Date&#xA;END&#xA;&#xA;&#xA;&#xA;TRUNCATE TABLE XREF_TRCR_Disposition&#xA;&#xA;EXEC DropIndexes 'XREF_TRCR_Disposition'&#xA;&#xA;;WITH TRCR_DISPOSITION_cte AS&#xA;      (SELECT TRCRD.Case_Violation_Id&#xA;             ,TRCRD.Judge_Id&#xA;             ,TRCRD.Sentence_Id&#xA;             ,TRCRD.Date_Of_Sentence&#xA;             ,TRCRD.Total_Jail&#xA;             ,TRCRD.Suspended_Jail&#xA;             ,TRCRD.Date_Final_Plea&#xA;             ,TRCRD.Final_Plea_Id&#xA;             ,TRCRD.Suspension_Comments&#xA;             ,TRCRD.Points_Assessed&#xA;             ,TRCRD.Credit_Days&#xA;             ,TRCRD.Jail_From&#xA;             ,TRCRD.Disposition_Id&#xA;             ,TRCRD.OCC_Priviledges_Comments&#x9;--gbdi-918&#xA;             ,TRCRD.MO_Narrative_Id&#xA;             ,TRCRD.Probation_From&#xA;             ,TRCRD.Probation_To&#xA;             ,ROW_NUMBER() OVER(PARTITION BY TRCRD.Case_Violation_Id ORDER BY TRCRD.Date_Of_Sentence DESC, Disposition_Id DESC) AS SeqNbr&#xA;         FROM BMLakewood_Source.dbo.Traffic_Criminal_Disposition TRCRD WITH (NOLOCK)&#xA;       )&#xA;INSERT INTO XREF_TRCR_Disposition&#xA;(&#xA;     Case_Violation_Id&#xA;    ,Judge_Id&#xA;    ,Sentence_Id&#xA;    ,Date_Of_Sentence&#xA;    ,Total_Jail&#xA;    ,Suspended_Jail&#xA;    ,Date_Final_Plea&#xA;    ,Final_Plea_Id&#xA;    ,Suspension_Comments&#xA;    ,Points_Assessed&#xA;    ,Credit_Days&#xA;    ,Jail_From&#xA;    ,Disposition_Id&#xA;    ,SeqNbr&#xA;    ,OCC_Priviledges_Comments&#x9;--gbdi-918&#xA;    ,MO_Narrative_Id&#xA;    ,Probation_From&#x9;--GBDI-1063&#xA;    ,Probation_To&#x9;--GBDI-1063&#xA;)&#xA;SELECT TD.Case_Violation_Id&#xA;      ,TD.Judge_Id&#xA;      ,TD.Sentence_Id&#xA;      ,TD.Date_Of_Sentence&#xA;      ,TD.Total_Jail&#xA;      ,TD.Suspended_Jail&#xA;      ,TD.Date_Final_Plea&#xA;      ,TD.Final_Plea_Id&#xA;      ,TD.Suspension_Comments&#xA;      ,TD.Points_Assessed&#xA;      ,TD.Credit_Days&#xA;      ,TD.Jail_From&#xA;      ,TD.Disposition_Id&#xA;      ,TD.SeqNbr&#xA;      ,TD.OCC_Priviledges_Comments&#x9;--gbdi-918&#xA;      ,TD.MO_Narrative_Id&#xA;      ,TD.Probation_From&#x9;--GBDI-1063&#xA;      ,TD.Probation_To&#x9;&#x9;--GBDI-1063&#xA;  FROM TRCR_DISPOSITION_cte TD WITH (NOLOCK)&#xA;EXEC ReAddIndex&#xA;--454,070&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
