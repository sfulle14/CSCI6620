        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=PTG-CONVERSION1\SQL2016;Initial Catalog=BMLakewood_Conv;Provider=SQLNCLI11.1;Integrated Security=SSPI;Auto Translate=False;" />
