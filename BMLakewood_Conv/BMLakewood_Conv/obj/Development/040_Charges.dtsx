      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DEAD7810-C017-41FF-9C6B-6EBD527DCAD6}"
          SQLTask:SqlStatementSource="&#xA;--Once the delete statement runs in the next conversion pass comment it out so that it doesnt run again Posted 4/21/22&#xA;--Delete from [BMLakewood_Conv].[dbo].[tblLookup] where UseDescription = 'Degree Of Violations' -- Ran 5/25/2022&#xA;&#xA;INSERT INTO tblLookup&#xA;            (Code&#xA;            ,Description&#xA;            ,LookupGroup&#xA;            ,LookupKey&#xA;            ,UseDescription&#xA;            ,DisplayOrder&#xA;            ,OBTSCode&#xA;            ,TCATSCode&#xA;            ,SRSCode&#xA;            ,Active&#xA;            ,ICPEnabled&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,CCISCode&#xA;            ,CCOCSubType)&#xA;  SELECT -- LookupID&#xA;         LTRIM(RTRIM(DOV.Degree)) AS Code&#xA;        ,LTRIM(RTRIM(DOV.Description)) AS Description&#xA;        ,'ChargeDegree' AS LookupGroup&#xA;        ,CONVERT(VARCHAR(50),DOV.Degree_Of_Violation_Id) AS LookupKey&#xA;        ,'Degree Of Violations' AS UseDescription&#xA;        ,99999 AS DisplayOrder&#xA;        ,'' AS OBTSCode&#xA;        ,'' AS TCATSCode&#xA;        ,'' AS SRSCode&#xA;        ,1 AS Active&#xA;        ,1 AS ICPEnabled&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,'' AS CCISCode&#xA;        ,'' AS CCOCSubType&#xA;    FROM BMLakewood_Source.dbo.Degree_Of_Violations DOV WITH (NOLOCK)&#xA;         LEFT OUTER JOIN tblLookup L WITH (NOLOCK) ON L.LookupGroup = 'ChargeDegree' AND L.Code = LTRIM(RTRIM(DOV.Degree))&#xA;   WHERE ISNULL(LTRIM(RTRIM(DOV.Degree)),'') &gt; ''&#xA;     AND L.Code IS NULL&#xA;ORDER BY DOV.Degree_Of_Violation_Id&#xA;--11&#xA;&#xA;&#xA;SET IDENTITY_INSERT tblStatute ON&#xA;&#xA;INSERT INTO tblStatute&#xA;            (StatuteID&#xA;            ,UserDefinedCode&#xA;            ,StatuteNumber&#xA;            ,StatuteShortDescription&#xA;            ,StatuteLongDescription&#xA;            ,Active&#xA;            ,ChargeLevel&#xA;            ,ChargeDegree&#xA;            ,GeneralOffenseCharacter&#xA;            ,Chapter&#xA;            ,Section&#xA;            ,Subsection&#xA;            ,OrdinanceNumber&#xA;            ,StateCode&#xA;            ,OffenseActivity&#xA;            ,ChargeCode&#xA;            ,ViolationCode&#xA;            ,StateStatute&#xA;            ,CitationRequired&#xA;            ,TemplateID&#xA;            ,DefaultCourtTypeID&#xA;            ,DefaultCaseTypeID&#xA;            ,MinFineAmount&#xA;            ,MaxFineAmount&#xA;            ,DiscretionaryFineAmount&#xA;            ,MinCourtCost&#xA;            ,MaxCourtCost&#xA;            ,ServiceFee&#xA;            ,ProratedFineBasedOn&#xA;            ,ProratedFineString&#xA;            ,FineRequirementType&#xA;            ,AllowSchool&#xA;            ,SchoolFineDiscount&#xA;            ,CourtCostFeeID&#xA;            ,CaseEventRequired&#xA;            ,SendToTCATS&#xA;            ,ViolationGroup&#xA;            ,ComplaintVerbiage&#xA;            ,AllowedOffenseActivity&#xA;            ,AllowedDrugType&#xA;            ,MinAgeRequired&#xA;            ,MinBondAmount&#xA;            ,DefaultBondReleaseOptions&#xA;            ,FDLECode&#xA;            ,MinConfinementLength&#xA;            ,MaxConfinementLength&#xA;            ,CreateByUserID&#xA;            ,CreateDate&#xA;            ,ModifyByUserID&#xA;            ,ModifyDate&#xA;            ,DrugRelated&#xA;            ,WeaponsRelated&#xA;            ,FTAStatuteID&#xA;            ,FTABondAmount&#xA;            ,ExcludeFromBCCS&#xA;            ,TCATSViolationType&#xA;            ,StartEffectiveDate&#xA;            ,EndEffectiveDate&#xA;            ,MergeToStatuteID&#xA;            ,StatuteCategoryID&#xA;            ,SRSCategory&#xA;            ,StatuteFineGroupID&#xA;            ,RequireSpeeds&#xA;            ,AdditionalCourtCost&#xA;            ,JuvenileMinCourtCost&#xA;            ,JuvenileAdditionalCourtCost&#xA;            ,CivilHearingMinCourtCost&#xA;            ,ChargePoints&#xA;            ,DisallowSchoolOverageAmount&#xA;            ,CCISViolationType&#xA;            ,JuvenileServiceFee&#xA;            ,VORRequired&#xA;            ,ConstructionZoneModifier&#xA;            ,SchoolZoneModifier&#xA;            ,CCOCSubType)&#xA;  SELECT VC.Violation_Id AS StatuteID&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS UserDefinedCode&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS StatuteNumber&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE WHEN VC.Is_Moving_Violation = 1 THEN 'M' ELSE '' END AS ViolationGroup&#xA;        ,'' AS ComplaintVerbiage&#xA;        ,'' AS AllowedOffenseActivity&#xA;        ,'' AS AllowedDrugType&#xA;        ,0 AS MinAgeRequired&#xA;        ,0 AS MinBondAmount&#xA;        ,'' AS DefaultBondReleaseOptions&#xA;        ,'' AS FDLECode&#xA;        ,'' AS MinConfinementLength&#xA;        ,'' AS MaxConfinementLength&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS DrugRelated&#xA;        ,0 AS WeaponsRelated&#xA;        ,0 AS FTAStatuteID&#xA;        ,0 AS FTABondAmount&#xA;        ,0 AS ExcludeFromBCCS&#xA;        ,'' AS TCATSViolationType&#xA;        ,NULL AS StartEffectiveDate&#xA;        ,VC.Date_Valid_To AS EndEffectiveDate&#xA;        ,0 AS MergeToStatuteID&#xA;        ,0 AS StatuteCategoryID&#xA;        ,'' AS SRSCategory&#xA;        ,0 AS StatuteFineGroupID&#xA;        ,0 AS RequireSpeeds&#xA;        ,0 AS AdditionalCourtCost&#xA;        ,0 AS JuvenileMinCourtCost&#xA;        ,0 AS JuvenileAdditionalCourtCost&#xA;        ,0 AS CivilHearingMinCourtCost&#xA;        ,ISNULL(VC.BMV_Points,0) AS ChargePoints&#xA;        ,0 AS DisallowSchoolOverageAmount&#xA;        ,'' AS CCISViolationType&#xA;        ,0 AS JuvenileServiceFee&#xA;        ,0 AS VORRequired&#xA;        ,0 AS ConstructionZoneModifier&#xA;        ,0 AS SchoolZoneModifier&#xA;        ,'' AS CCOCSubType&#xA;    FROM BMLakewood_Source.dbo.Violation_Codes VC WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Degree_Of_Violations DOV WITH (NOLOCK) ON DOV.Degree_Of_Violation_Id = VC.Offense_Degree&#xA;         LEFT OUTER JOIN tblStatute S WITH (NOLOCK) ON S.StatuteID = VC.Violation_Id&#xA;   WHERE VC.Agency_Id = 1 &#xA;UNION&#xA; SELECT VC.Violation_Id AS StatuteID&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS UserDefinedCode&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS StatuteNumber&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE WHEN VC.Is_Moving_Violation = 1 THEN 'M' ELSE '' END AS ViolationGroup&#xA;        ,'' AS ComplaintVerbiage&#xA;        ,'' AS AllowedOffenseActivity&#xA;        ,'' AS AllowedDrugType&#xA;        ,0 AS MinAgeRequired&#xA;        ,0 AS MinBondAmount&#xA;        ,'' AS DefaultBondReleaseOptions&#xA;        ,'' AS FDLECode&#xA;        ,'' AS MinConfinementLength&#xA;        ,'' AS MaxConfinementLength&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS DrugRelated&#xA;        ,0 AS WeaponsRelated&#xA;        ,0 AS FTAStatuteID&#xA;        ,0 AS FTABondAmount&#xA;        ,0 AS ExcludeFromBCCS&#xA;        ,'' AS TCATSViolationType&#xA;        ,NULL AS StartEffectiveDate&#xA;        ,VC.Date_Valid_To AS EndEffectiveDate&#xA;        ,0 AS MergeToStatuteID&#xA;        ,0 AS StatuteCategoryID&#xA;        ,'' AS SRSCategory&#xA;        ,0 AS StatuteFineGroupID&#xA;        ,0 AS RequireSpeeds&#xA;        ,0 AS AdditionalCourtCost&#xA;        ,0 AS JuvenileMinCourtCost&#xA;        ,0 AS JuvenileAdditionalCourtCost&#xA;        ,0 AS CivilHearingMinCourtCost&#xA;        ,ISNULL(VC.BMV_Points,0) AS ChargePoints&#xA;        ,0 AS DisallowSchoolOverageAmount&#xA;        ,'' AS CCISViolationType&#xA;        ,0 AS JuvenileServiceFee&#xA;        ,0 AS VORRequired&#xA;        ,0 AS ConstructionZoneModifier&#xA;        ,0 AS SchoolZoneModifier&#xA;        ,'' AS CCOCSubType&#xA;    FROM BMLakewood_Source.dbo.Violation_Codes VC WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Degree_Of_Violations DOV WITH (NOLOCK) ON DOV.Degree_Of_Violation_Id = VC.Offense_Degree&#xA;         LEFT OUTER JOIN tblStatute S WITH (NOLOCK) ON S.StatuteID = VC.Violation_Id&#xA;   WHERE VC.Agency_Id = 2 AND VC.Section_Number NOT IN (select VC.Section_Number from BMLakewood_Source.dbo.Violation_Codes VC with (nolock) where VC.Agency_Id IN (1))&#xA;UNION&#xA;SELECT VC.Violation_Id AS StatuteID&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS UserDefinedCode&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS StatuteNumber&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE WHEN VC.Is_Moving_Violation = 1 THEN 'M' ELSE '' END AS ViolationGroup&#xA;        ,'' AS ComplaintVerbiage&#xA;        ,'' AS AllowedOffenseActivity&#xA;        ,'' AS AllowedDrugType&#xA;        ,0 AS MinAgeRequired&#xA;        ,0 AS MinBondAmount&#xA;        ,'' AS DefaultBondReleaseOptions&#xA;        ,'' AS FDLECode&#xA;        ,'' AS MinConfinementLength&#xA;        ,'' AS MaxConfinementLength&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS DrugRelated&#xA;        ,0 AS WeaponsRelated&#xA;        ,0 AS FTAStatuteID&#xA;        ,0 AS FTABondAmount&#xA;        ,0 AS ExcludeFromBCCS&#xA;        ,'' AS TCATSViolationType&#xA;        ,NULL AS StartEffectiveDate&#xA;        ,VC.Date_Valid_To AS EndEffectiveDate&#xA;        ,0 AS MergeToStatuteID&#xA;        ,0 AS StatuteCategoryID&#xA;        ,'' AS SRSCategory&#xA;        ,0 AS StatuteFineGroupID&#xA;        ,0 AS RequireSpeeds&#xA;        ,0 AS AdditionalCourtCost&#xA;        ,0 AS JuvenileMinCourtCost&#xA;        ,0 AS JuvenileAdditionalCourtCost&#xA;        ,0 AS CivilHearingMinCourtCost&#xA;        ,ISNULL(VC.BMV_Points,0) AS ChargePoints&#xA;        ,0 AS DisallowSchoolOverageAmount&#xA;        ,'' AS CCISViolationType&#xA;        ,0 AS JuvenileServiceFee&#xA;        ,0 AS VORRequired&#xA;        ,0 AS ConstructionZoneModifier&#xA;        ,0 AS SchoolZoneModifier&#xA;        ,'' AS CCOCSubType&#xA;    FROM BMLakewood_Source.dbo.Violation_Codes VC WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Degree_Of_Violations DOV WITH (NOLOCK) ON DOV.Degree_Of_Violation_Id = VC.Offense_Degree&#xA;         LEFT OUTER JOIN tblStatute S WITH (NOLOCK) ON S.StatuteID = VC.Violation_Id&#xA;   WHERE VC.Agency_Id = 3 AND VC.Section_Number NOT IN (select VC.Section_Number from BMLakewood_Source.dbo.Violation_Codes VC with (nolock) where VC.Agency_Id IN (1,2))&#xA;UNION&#xA;SELECT VC.Violation_Id AS StatuteID&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS UserDefinedCode&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS StatuteNumber&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE WHEN VC.Is_Moving_Violation = 1 THEN 'M' ELSE '' END AS ViolationGroup&#xA;        ,'' AS ComplaintVerbiage&#xA;        ,'' AS AllowedOffenseActivity&#xA;        ,'' AS AllowedDrugType&#xA;        ,0 AS MinAgeRequired&#xA;        ,0 AS MinBondAmount&#xA;        ,'' AS DefaultBondReleaseOptions&#xA;        ,'' AS FDLECode&#xA;        ,'' AS MinConfinementLength&#xA;        ,'' AS MaxConfinementLength&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS DrugRelated&#xA;        ,0 AS WeaponsRelated&#xA;        ,0 AS FTAStatuteID&#xA;        ,0 AS FTABondAmount&#xA;        ,0 AS ExcludeFromBCCS&#xA;        ,'' AS TCATSViolationType&#xA;        ,NULL AS StartEffectiveDate&#xA;        ,VC.Date_Valid_To AS EndEffectiveDate&#xA;        ,0 AS MergeToStatuteID&#xA;        ,0 AS StatuteCategoryID&#xA;        ,'' AS SRSCategory&#xA;        ,0 AS StatuteFineGroupID&#xA;        ,0 AS RequireSpeeds&#xA;        ,0 AS AdditionalCourtCost&#xA;        ,0 AS JuvenileMinCourtCost&#xA;        ,0 AS JuvenileAdditionalCourtCost&#xA;        ,0 AS CivilHearingMinCourtCost&#xA;        ,ISNULL(VC.BMV_Points,0) AS ChargePoints&#xA;        ,0 AS DisallowSchoolOverageAmount&#xA;        ,'' AS CCISViolationType&#xA;        ,0 AS JuvenileServiceFee&#xA;        ,0 AS VORRequired&#xA;        ,0 AS ConstructionZoneModifier&#xA;        ,0 AS SchoolZoneModifier&#xA;        ,'' AS CCOCSubType&#xA;    FROM BMLakewood_Source.dbo.Violation_Codes VC WITH (NOLOCK)&#xA;         LEFT OUTER JOIN BMLakewood_Source.dbo.Degree_Of_Violations DOV WITH (NOLOCK) ON DOV.Degree_Of_Violation_Id = VC.Offense_Degree&#xA;         LEFT OUTER JOIN tblStatute S WITH (NOLOCK) ON S.StatuteID = VC.Violation_Id&#xA;   WHERE VC.Agency_Id = 4 AND VC.Section_Number NOT IN (select VC.Section_Number from BMLakewood_Source.dbo.Violation_Codes VC with (nolock) where VC.Agency_Id IN (1,2,3))&#xA;UNION&#xA;SELECT VC.Violation_Id AS StatuteID&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS UserDefinedCode&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') AS StatuteNumber&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteShortDescription&#xA;        ,ISNULL(LTRIM(RTRIM(VC.Violation_Description)),'') AS StatuteLongDescription&#xA;        ,1 AS Active&#xA;        ,CASE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') WHEN 'U' THEN 'F' ELSE ISNULL(SUBSTRING(LTRIM(RTRIM(DOV.Degree)),1,1),'') END AS ChargeLevel&#xA;        ,ISNULL(LTRIM(RTRIM(DOV.Description)),'') AS ChargeDegree&#xA;        ,'' AS GeneralOffenseCharacter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),1,CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) - 1)&#xA;              ELSE '' &#xA;          END AS Chapter&#xA;        ,CASE WHEN CHARINDEX('.',VC.Section_Number) &gt; 0 AND ISNULL(LTRIM(RTRIM(VC.Section_Number)),'') &gt; ''&#xA;              THEN SUBSTRING(LTRIM(RTRIM(VC.Section_Number)),CHARINDEX('.',LTRIM(RTRIM(VC.Section_Number))) + 1,99)&#xA;              ELSE '' &#xA;          END AS [Section]&#xA;        ,'' AS Subsection&#xA;        ,'' AS OrdinanceNumber&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS StateCode&#xA;        ,'' AS OffenseActivity&#xA;        ,'' AS ChargeCode&#xA;        ,ISNULL(REPLACE(VC.BMV_Violation_Code,'00',''),'') AS ViolationCode&#xA;        ,0 AS StateStatute&#xA;        ,0 AS CitationRequired&#xA;        ,0 AS TemplateID&#xA;        ,0 AS DefaultCourtTypeID&#xA;        ,0 AS DefaultCaseTypeID&#xA;        ,ISNULL(VC.Fine,0) AS MinFineAmount&#xA;        ,0 AS MaxFineAmount&#xA;        ,0 AS DiscretionaryFineAmount&#xA;        ,0 AS MinCourtCost&#xA;        ,0 AS MaxCourtCost&#xA;        ,0 AS ServiceFee&#xA;        ,'' AS ProratedFineBasedOn&#xA;        ,'' AS ProratedFineString&#xA;        ,0 AS FineRequirementType&#xA;        ,0 AS AllowSchool&#xA;        ,0 AS SchoolFineDiscount&#xA;        ,0 AS CourtCostFeeID&#xA;        ,0 AS CaseEventRequired&#xA;        ,0 AS SendToTCATS&#xA;        ,CASE WHEN VC.Is_Moving_Violation = 1 THEN 'M' ELSE '' END AS ViolationGroup&#xA;        ,'' AS ComplaintVerbiage&#xA;        ,'' AS AllowedOffenseActivity&#xA;        ,'' AS AllowedDrugType&#xA;        ,0 AS MinAgeRequired&#xA;        ,0 AS MinBondAmount&#xA;        ,'' AS DefaultBondReleaseOptions&#xA;        ,'' AS FDLECode&#xA;        ,'' AS MinConfinementLength&#xA;        ,'' AS MaxConfinementLength&#xA;        ,1 AS CreateByUserID&#xA;        ,CURRENT_TIMESTAMP AS CreateDate&#xA;        ,1 AS ModifyByUserID&#xA;        ,CURRENT_TIMESTAMP AS ModifyDate&#xA;        ,0 AS DrugRelated&#xA;        ,0 AS WeaponsRelated&#xA;        ,0 AS FTAStatuteID&#xA;        ,0 AS FTABondAmount&#xA;        ,0 AS ExcludeFromBCCS&#xA;        ,'' A